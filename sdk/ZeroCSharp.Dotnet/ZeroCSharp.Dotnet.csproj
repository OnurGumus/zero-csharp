<!-- Packs lib/ built for .NET (dotnet/ZeroLib: ZeroLib.dll; dotnet/ZeroLib.FSharp: zero's F#
     task/async/MailboxProcessor as FSharp.Control.dll), which F# projects on
     ZeroTarget=dotnet reference (Sdk/ZeroDotnet.targets downloads it, as a
     PackageDownload, so a library built with it doesn't depend on it).
     sdk/pack.sh builds dotnet/ZeroLib.FSharp first: it needs the .NET SDK 11. -->
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../version.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>

    <PackageId>ZeroCSharp.Dotnet</PackageId>
    <Version>$(ZeroSdkVersion)</Version>
    <Authors>Zero C# contributors</Authors>
    <Description>Zero C#'s lib/ built for .NET, for F# projects built with ZeroCSharp.Sdk and ZeroTarget=dotnet: the SDK references it. Not for use on its own.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://onurgumus.github.io/zero-csharp/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/OnurGumus/zero-csharp</RepositoryUrl>
    <PackageTags>fsharp;zero</PackageTags>
    <ZeroLibBin>../../dotnet/ZeroLib.FSharp/bin/Release/net11.0/</ZeroLibBin>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(ZeroLibBin)ZeroLib.dll;$(ZeroLibBin)ZeroLib.pdb;$(ZeroLibBin)FSharp.Control.dll;$(ZeroLibBin)FSharp.Control.pdb"
          Pack="true" PackagePath="dotnet/" />
    <None Include="../../lib/THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="lib-THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
  <Target Name="ZeroCheckBuilt" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(ZeroLibBin)ZeroLib.dll') or !Exists('$(ZeroLibBin)FSharp.Control.dll')"
           Text="dotnet/ZeroLib isn't built: dotnet build -c Release dotnet/ZeroLib.FSharp (the .NET SDK 11)." />
  </Target>
</Project>
