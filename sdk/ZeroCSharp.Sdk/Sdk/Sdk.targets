<Project>
  <!-- ZeroTarget=dotnet (see Sdk.props): an ordinary .NET program with lib/
       compiled in. None of what follows about zerocore, bflat and native
       code applies; ZeroDotnet.targets has what does. -->
  <Import Project="ZeroDotnet.targets" Condition="'$(_ZeroDotnet)' == 'true'" />

  <PropertyGroup Condition="'$(_ZeroDotnet)' != 'true'">
    <ZeroRefDir>$(ZeroSdkRoot)payload/ref/</ZeroRefDir>
    <!-- Setting these skips MSBuild's search for an installed targeting pack,
         which doesn't exist for this framework. -->
    <_TargetFrameworkDirectories>$(ZeroRefDir)</_TargetFrameworkDirectories>
    <_FullFrameworkReferenceAssemblyPaths>$(ZeroRefDir)</_FullFrameworkReferenceAssemblyPaths>

    <!-- NativeLib=Shared (NativeAOT's name) with OutputType Library: a native
         shared library (.so, .dylib, .dll) exporting the project's
         [UnmanagedCallersOnly(EntryPoint = "...")] methods, instead of a zero
         library (IL that other zero projects compile in, packed for NuGet). -->
    <ZeroNativeLibrary Condition="'$(NativeLib)' == 'Shared' and '$(OutputType)' == 'Library'">true</ZeroNativeLibrary>
    <!-- Whether the build makes native code: a program, or a native library. -->
    <ZeroBuildsNative Condition="'$(OutputType)' != 'Library' or '$(ZeroNativeLibrary)' == 'true'">true</ZeroBuildsNative>
    <IsPackable Condition="'$(NativeLib)' != ''">false</IsPackable>
    <!-- A program's PDB in the output folder is the linker's (Windows), the one
         debuggers want: the C# compiler's, for IL that nothing runs, stays in obj/. -->
    <CopyOutputSymbolsToOutputDirectory Condition="'$(OutputType)' != 'Library'">false</CopyOutputSymbolsToOutputDirectory>
  </PropertyGroup>

  <ItemGroup Condition="'$(ZeroLanguage)' == 'CSharp' and '$(_ZeroDotnet)' != 'true'">
    <Reference Include="$(ZeroRefDir)System.Private.CoreLib.dll" Private="false" ZeroFramework="true" />
    <!-- The compiler the bflat fork uses: unions and the updated memory safety rules. -->
    <PackageReference Include="Microsoft.Net.Compilers.Toolset" Version="5.12.0" PrivateAssets="all" IsImplicitlyDefined="true" />
  </ItemGroup>
  <!-- F#: zerocore under the file name fsc takes its primary assembly from
       (the IL it writes still names System.Private.CoreLib), the BCL types fsc
       needs that zerocore lacks, and FSharp.Core. bflat gets zerocore under
       its own name instead (ZeroNative="false" here, ZeroNativeCommand). -->
  <ItemGroup Condition="'$(ZeroLanguage)' == 'FSharp' and '$(_ZeroDotnet)' != 'true'">
    <Reference Include="$(ZeroRefDir)fsharp/System.Runtime.dll" Private="false" ZeroFramework="true" ZeroNative="false" />
    <Reference Include="$(ZeroRefDir)fsharp/System.Runtime.Extensions.dll" Private="false" ZeroFramework="true" />
    <Reference Include="$(ZeroRefDir)fsharp/FSharp.Core.dll" Private="false" ZeroFramework="true" />
    <!-- printf and the others (fsharp/printf/Printf.fs); next to BflatLib,
         which its signatures name. -->
    <Reference Include="$(ZeroRefDir)FSharp.Printf.dll" Private="false" ZeroFramework="true" />
    <!-- async, task and MailboxProcessor (fsharp/control/Control.fs); next to
         BflatLib, which its signatures name (see fsharp/build-core.sh). -->
    <Reference Include="$(ZeroRefDir)FSharp.Control.dll" Private="false" ZeroFramework="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(_ZeroDotnet)' != 'true'">
    <Reference Include="$(ZeroRefDir)BflatLib.dll" Private="false" ZeroFramework="true" />
  </ItemGroup>

  <!-- bflat for this host, restored with the project. -->
  <ItemGroup Condition="'$(ZeroHostRid)' != '' and '$(ZeroBuildsNative)' == 'true'">
    <PackageDownload Include="ZeroCSharp.Bflat.$(ZeroHostRid)" Version="[$(ZeroSdkVersion)]" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- Like dotnet build -r <rid>: a chosen target's program goes in a folder
       named after it, so programs for several targets sit side by side; the
       default build's goes in the output folder itself. Here, after the project
       and Directory.Build.targets, a ZeroTarget other than the host's is chosen. -->
  <PropertyGroup>
    <ZeroTargetFolder Condition="'$(ZeroTargetChosen)' == 'true' or '$(ZeroTarget)' != '$(ZeroHostRid)'">$(ZeroTarget)/</ZeroTargetFolder>
    <!-- The targets bflat doesn't compile for: it makes IL, NativeAOT-LLVM
         makes LLVM bitcode of that, and zero-bitcode takes it from there. -->
    <!-- The feature switches for NativeAOT-LLVM (the bitcode targets). -->
    <_ZeroIlcFeatures Condition="'$(ZeroIdeographOrders)' == 'false'">--feature:Zero.Globalization.IdeographOrders=false</_ZeroIlcFeatures>
    <_ZeroBitcodeTarget Condition="'$(ZeroTarget)' == 'c64' or '$(ZeroTarget)' == 'pico2' or '$(ZeroTarget)' == 'r4'">true</_ZeroBitcodeTarget>
    <!-- Apple's platforms: bflat compiles a Mach-O object (as macOS), and the
         package's ld64.lld links it. The iOS simulator runs the same arm64
         code; its object is marked as built for it first (ZeroNativeBuild). -->
    <_ZeroApple Condition="'$(ZeroTarget)' == 'osx-arm64' or '$(ZeroTarget)' == 'iossimulator-arm64'">true</_ZeroApple>
    <!-- The oldest iOS a simulator program starts on. -->
    <ZeroIosMinimum Condition="'$(ZeroIosMinimum)' == ''">17.0</ZeroIosMinimum>
  </PropertyGroup>

  <!--
    The native step: after the normal compile (which checks the code the way the
    editor sees it), bflat compiles the same sources, with zerocore, lib/ and the
    project's zero libraries, into a native program. The flags are build.sh's.
    F#: bflat compiles only C#, so it compiles a one-method C# program that
    calls the F# entry point (ZeroFSharpEntry), with the F# compiler's IL as a
    reference, and makes native code of both.
  -->
  <!-- After the output is copied and before IncrementalClean, which records
       FileWrites: dotnet clean then removes the native program too. -->
  <Target Name="ZeroNativeBuild" AfterTargets="CopyFilesToOutputDirectory" BeforeTargets="IncrementalClean"
          Condition="'$(ZeroBuildsNative)' == 'true' and '$(_ZeroBitcodeTarget)' != 'true'"
          DependsOnTargets="ZeroCheckNativeLib;ZeroCheckNativeHost;ZeroNativeCommand;ZeroFSharpEntry;ZeroGpuKernels"
          Inputs="@(Compile);@(ZeroLibraryReference);@(ZeroNativeInput);@(ZeroResolvedLinkLibrary);$(ZeroNativeArgsFile);@(ZeroFSharpNativeInput);$(ZeroLinkArgsInput);$(ZeroGpuObjects)"
          Outputs="$(ZeroNativeOutput);$(ZeroDebugObject)">
    <!-- NuGet doesn't keep the executable bit; a packages folder that's
         read-only (shared or mounted) must already have it. -->
    <Exec Condition="'$(OS)' != 'Windows_NT'" Command="test -x &quot;$(ZeroBflatDir)bflat&quot; &amp;&amp; test -x &quot;$(ZeroBflatDir)bin/lld&quot; || chmod +x &quot;$(ZeroBflatDir)bflat&quot; &quot;$(ZeroBflatDir)bin/lld&quot;" />
    <!-- bflat doesn't make the folder (a target's own, for a chosen target). -->
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(ZeroNativeOutput)'));$([System.IO.Path]::GetDirectoryName('$(ZeroBflatOutput)'))" />
    <!-- The arguments as a response file: cmd.exe (Exec on Windows) stops at
         8191 characters, which a project's full source paths can pass. -->
    <Message Text="bflat arguments: $(ZeroNativeArgs)" />
    <!-- The output is kept, to explain one failure ILC reports in its own
         terms (ZERO015); bflat's errors are reported as they come either way. -->
    <Exec Command="&quot;$(ZeroBflatExe)&quot; build @&quot;$(ZeroNativeArgsFile)&quot;" ConsoleToMSBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_ZeroBflatExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_ZeroBflatOutput" />
    </Exec>
    <PropertyGroup>
      <_ZeroBflatText>@(_ZeroBflatOutput)</_ZeroBflatText>
    </PropertyGroup>
    <!-- ILC found a method whose IL it can't compile (invalid code, such as F#
         boxing a span to call a method it doesn't define), and looked for the
         helper .NET compiles in its place, which zerocore leaves out on
         purpose: such a program fails here rather than when the method runs. -->
    <Error Code="ZERO015" Condition="'$(_ZeroBflatExitCode)' != '0' and $(_ZeroBflatText.Contains('ThrowInvalidProgramExceptionWithArgument'))"
           Text="A method of the program has code the native compiler can't compile (invalid IL), so the build stops here instead of the program failing when the method runs. ILC doesn't say which method; look for code new since the last good build that calls a method on a span or another ref struct that the type doesn't define itself (Equals, GetHashCode, ToString), or boxes one." />
    <Error Condition="'$(_ZeroBflatExitCode)' != '0'" Text="The command &quot;$(ZeroBflatExe)&quot; build @&quot;$(ZeroNativeArgsFile)&quot; exited with code $(_ZeroBflatExitCode)." />
    <!-- F#: the program bflat wrote under its own name (and Windows' PDB). -->
    <Copy SourceFiles="$(ZeroBflatOutput)" DestinationFiles="$(ZeroNativeOutput)" Condition="'$(ZeroBflatOutput)' != '$(ZeroNativeOutput)' and '$(_ZeroApple)' != 'true'" />
    <Copy SourceFiles="$([System.IO.Path]::ChangeExtension('$(ZeroBflatOutput)', '.pdb'))" DestinationFiles="$([System.IO.Path]::ChangeExtension('$(ZeroNativeOutput)', '.pdb'))"
          Condition="'$(ZeroBflatOutput)' != '$(ZeroNativeOutput)' and '$(ZeroTarget)' == 'win-x64' and Exists('$([System.IO.Path]::ChangeExtension($(ZeroBflatOutput), `.pdb`))')" />
    <!-- macOS and the iOS simulator: bflat only compiles (it has no Mach-O
         linker); the package's lld links, as ld64.lld, against the payload's
         libSystem.tbd. bflat's object says it's for macOS, which ld64.lld won't
         put in a program for the simulator: zero-bitcode marks it as built for
         the simulator. -->
    <Exec Command="$(_ZeroBitcode) macho-platform &quot;$(ZeroNativeObject)&quot; ios-simulator $(ZeroIosMinimum)" Condition="'$(ZeroTarget)' == 'iossimulator-arm64'" />
    <Message Text="ld64 arguments: $(ZeroLinkArgs)" Condition="'$(_ZeroApple)' == 'true'" />
    <!-- lld's errors and warnings as MSBuild's, except "<dylib> has version
         27.2.0, which is newer than target minimum of 12.0": a library on the
         build machine (Homebrew's SDL, say) is built for its own macOS, and
         the program uses whichever one the machine it runs on has. That line
         stays in the log (-v:n), as a message. -->
    <Exec Command="&quot;$(ZeroLldExe)&quot; -flavor darwin @&quot;$(ZeroLinkArgsFile)&quot;" Condition="'$(_ZeroApple)' == 'true' and '$(ZeroGpu)' != 'Metal'"
          IgnoreStandardErrorWarningFormat="true" StandardErrorImportance="normal"
          CustomErrorRegularExpression="^lld: error: "
          CustomWarningRegularExpression="^lld: warning: (?!.*, which is newer than target minimum of )" />
    <!-- ZeroGpu: Xcode's own linker, with the same arguments: the frameworks
         come from Xcode's macOS SDK, whose .tbd files name architectures
         (arm64e.x1) that the package's lld can't read. -->
    <Exec Command="xcrun ld @&quot;$(ZeroLinkArgsFile)&quot;" Condition="'$(ZeroTarget)' == 'osx-arm64' and '$(ZeroGpu)' == 'Metal'"
          IgnoreStandardErrorWarningFormat="true" StandardErrorImportance="normal"
          CustomErrorRegularExpression="^ld: error|^Undefined symbols" CustomWarningRegularExpression="^ld: warning: " />
    <Message Importance="high" Text="$(MSBuildProjectName) -> $(ZeroNativeOutput)" />
  </Target>

  <!--
    ZeroGpu=Metal: the program's kernels, its [RuntimeExport("Name")] methods,
    for the GPU. NativeAOT-LLVM compiles the IL to bitcode, with the kernels
    whether the program calls them or not (zero-bitcode gpu-bitcode; on a Mac
    in Docker, downloaded on the first such build, as for the C64); then
    zero-bitcode gpu-kernels makes Metal kernels of them with Xcode's Metal
    compiler, a metallib in kernels.o, and compiles metal.m (Metal behind the
    C functions lib/Gpu.cs calls) to metal.o. ZeroNativeBuild links both.
    ZeroGpu=Cuda (experimental): the same bitcode; zero-bitcode cuda-kernels
    makes PTX of the kernels with a clang that has the NVPTX backend, and an
    ELF object, kernels.o, that holds it. ZeroNativeBuild links that and the
    payload's cuda.o (gpu/cuda.c: CUDA's driver API, opened at run time).
  -->
  <Target Name="ZeroGpuKernels" Condition="('$(ZeroGpu)' == 'Metal' or '$(ZeroGpu)' == 'Cuda') and '$(ZeroBuildsNative)' == 'true'"
          DependsOnTargets="ZeroNativeCommand"
          Inputs="@(IntermediateAssembly);@(ZeroLibraryReference);$(ZeroGpuSource)"
          Outputs="$(ZeroGpuObjects)">
    <MakeDir Directories="$(ZeroGpuDir)" />
    <!-- Cuda: a missing or unfit clang is reported before NativeAOT-LLVM runs. -->
    <Exec Command="$(_ZeroBitcode) cuda-clang &quot;$(ZeroCudaClang)&quot;" Condition="'$(ZeroGpu)' == 'Cuda'" StandardOutputImportance="low" />
    <!-- Against zerocore's build for bitcode targets, the C64's. -->
    <Exec Command="$(_ZeroBitcode) gpu-bitcode &quot;@(IntermediateAssembly->'%(FullPath)')&quot; &quot;$(ZeroGpuDir)bitcode&quot; &quot;$(ZeroSdkRoot)payload/native/c64/System.Private.CoreLib.dll&quot; &quot;$(ZeroRefDir)BflatLib.dll&quot; @(ZeroLibraryReference->'&quot;%(FullPath)&quot;', ' ')" />
    <Exec Command="$(_ZeroBitcode) gpu-kernels &quot;$(ZeroGpuDir)bitcode&quot; &quot;$(AssemblyName)&quot; &quot;$(ZeroSdkRoot)payload/native/gpu/metal.m&quot; &quot;$(ZeroGpuDir)&quot;" Condition="'$(ZeroGpu)' == 'Metal'" />
    <!-- Cuda: a clang with the NVPTX backend (ZeroCudaClang, or found), then
         ptxas if it's on the PATH; the PTX goes into kernels.o. -->
    <Exec Command="$(_ZeroBitcode) cuda-kernels &quot;$(ZeroGpuDir)bitcode&quot; &quot;$(AssemblyName)&quot; $(ZeroTarget.Substring(6)) &quot;$(ZeroGpuDir)&quot; &quot;$(ZeroCudaClang)&quot; &quot;$(ZeroCudaArch)&quot;" Condition="'$(ZeroGpu)' == 'Cuda'" />
    <ItemGroup>
      <FileWrites Include="$(ZeroGpuDir)**" />
    </ItemGroup>
  </Target>

  <!-- ZeroGpu: Xcode's macOS SDK, whose frameworks (Metal, Foundation) the
       program links with. -->
  <Target Name="_ZeroGpuMacSdk" Condition="'$(ZeroGpu)' == 'Metal' and '$(ZeroTarget)' == 'osx-arm64' and $([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Command="xcrun --sdk macosx --show-sdk-path" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ZeroMacSdk" />
      <Output TaskParameter="ExitCode" PropertyName="_ZeroXcrunExit" />
    </Exec>
    <Error Condition="'$(_ZeroXcrunExit)' != '0'"
           Text="ZeroGpu=Metal needs Xcode (its macOS SDK and Metal compiler): install it from the App Store, then run xcodebuild -downloadComponent MetalToolchain." />
  </Target>

  <!--
    The Commodore 64: bflat compiles the sources to IL, NativeAOT-LLVM that to
    LLVM bitcode (zero-bitcode c64-bitcode; on a Mac in Docker), and llvm-mos
    the bitcode, rewritten for the 6502, to a .prg (zero-bitcode c64-link).
    NativeAOT-LLVM and llvm-mos are downloaded on the first such build into a
    per-user cache (zero-bitcode's Tools.cs). Always optimized for size.
  -->
  <!-- The C64 link's options, from the project: in a file that changes only
       when they do, so that changing one links again (a property alone isn't
       an input MSBuild compares). -->
  <Target Name="ZeroC64LinkOptions" Condition="'$(ZeroBuildsNative)' == 'true' and '$(ZeroTarget)' == 'c64'">
    <PropertyGroup>
      <!-- ZeroC64Source: the program's own C (.c) or 6502 assembly (.s),
           compiled by llvm-mos with the rest; a function cs_NAME in it is
           what [DllImport("libc")] NAME calls. -->
      <_ZeroC64LinkOptions>@(ZeroC64Source->'--source &quot;%(FullPath)&quot;', ' ')</_ZeroC64LinkOptions>
      <!-- ZeroC64ShadowStack, ZeroC64StackReserve: bytes for the stack of
           object references (2048 by default) and for the 6502's soft stack
           below the heap (1024); the heap gets the rest. -->
      <_ZeroC64LinkOptions Condition="'$(ZeroC64ShadowStack)' != ''">$(_ZeroC64LinkOptions) --shadow-stack $(ZeroC64ShadowStack)</_ZeroC64LinkOptions>
      <_ZeroC64LinkOptions Condition="'$(ZeroC64StackReserve)' != ''">$(_ZeroC64LinkOptions) --stack-reserve $(ZeroC64StackReserve)</_ZeroC64LinkOptions>
      <!-- ZeroC64FastMultiply: 32-bit multiplication with a 1 KB table of
           quarter squares, about 700 cycles instead of 1,100 (c64/runtime.c,
           __mulsi3). -->
      <_ZeroC64LinkOptions Condition="'$(ZeroC64FastMultiply)' == 'true'">$(_ZeroC64LinkOptions) --fast-multiply</_ZeroC64LinkOptions>
      <ZeroC64LinkOptionsFile>$(ZeroBitcodeDir)c64-link.options</ZeroC64LinkOptionsFile>
    </PropertyGroup>
    <MakeDir Directories="$(ZeroBitcodeDir)" />
    <WriteLinesToFile File="$(ZeroC64LinkOptionsFile)" Lines="$(_ZeroC64LinkOptions)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="ZeroC64Build" AfterTargets="CopyFilesToOutputDirectory" BeforeTargets="IncrementalClean"
          Condition="'$(ZeroBuildsNative)' == 'true' and '$(ZeroTarget)' == 'c64'"
          DependsOnTargets="ZeroCheckNativeLib;ZeroCheckNativeHost;ZeroNativeCommand;ZeroFSharpEntry;ZeroC64LinkOptions"
          Inputs="@(Compile);@(ZeroLibraryReference);@(ZeroNativeInput);$(ZeroNativeArgsFile);@(ZeroFSharpNativeInput);@(ZeroC64Source);$(ZeroC64LinkOptionsFile)"
          Outputs="$(ZeroNativeOutput)">
    <PropertyGroup>
      <_ZeroDotnet>$(DOTNET_HOST_PATH)</_ZeroDotnet>
      <_ZeroDotnet Condition="'$(_ZeroDotnet)' == ''">dotnet</_ZeroDotnet>
      <_ZeroBitcode>&quot;$(_ZeroDotnet)&quot; &quot;$(ZeroSdkRoot)payload/tools/zero-bitcode/zero-bitcode.dll&quot;</_ZeroBitcode>
    </PropertyGroup>
    <Exec Condition="'$(OS)' != 'Windows_NT'" Command="test -x &quot;$(ZeroBflatDir)bflat&quot; || chmod +x &quot;$(ZeroBflatDir)bflat&quot;" />
    <MakeDir Directories="$(ZeroBitcodeDir);$([System.IO.Path]::GetDirectoryName('$(ZeroNativeOutput)'))" />
    <Message Text="bflat arguments: $(ZeroNativeArgs)" />
    <Exec Command="&quot;$(ZeroBflatExe)&quot; build-il @&quot;$(ZeroNativeArgsFile)&quot;" />
    <Exec Command="$(_ZeroBitcode) c64-bitcode &quot;$(ZeroBitcodeIl)&quot; &quot;$(ZeroBitcodeDir)bitcode&quot; &quot;$(ZeroNativeDir)System.Private.CoreLib.dll&quot; &quot;$(ZeroRefDir)BflatLib.dll&quot; @(_ZeroBitcodeReference->'&quot;%(Identity)&quot;', ' ') @(ZeroLibraryReference->'&quot;%(FullPath)&quot;', ' ') $(_ZeroIlcFeatures)" />
    <Exec Command="$(_ZeroBitcode) c64-link &quot;$(ZeroBitcodeDir)bitcode&quot; &quot;$([System.IO.Path]::GetFileNameWithoutExtension('$(ZeroBitcodeIl)'))&quot; &quot;$(ZeroNativeDir)runtime.c&quot; &quot;$(ZeroNativeOutput)&quot; $(_ZeroC64LinkOptions)" />
    <Message Importance="high" Text="$(MSBuildProjectName) -> $(ZeroNativeOutput)" />
  </Target>

  <!--
    Microcontrollers: the Raspberry Pi Pico 2 (pico2, an RP2350's Cortex-M33)
    and the Arduino Uno R4 (r4, a Cortex-M4). The same IL and bitcode as for
    the C64, optimized for speed (zero-bitcode arm-bitcode), and Arm Toolchain
    for Embedded's clang for the board's processor (zero-bitcode arm-link),
    downloaded on the first such build into the same cache; on a Mac it runs
    in Docker too. Each build makes the program for QEMU's stand-in board
    (qemu/<name>.elf for the pico2, <name>.elf for the r4: dotnet run runs it
    there), and for the pico2 the program for the real board: <name>.uf2, to
    copy to it, and <name>.elf, for a debug probe.
  -->
  <Target Name="ZeroArmBuild" AfterTargets="CopyFilesToOutputDirectory" BeforeTargets="IncrementalClean"
          Condition="'$(ZeroBuildsNative)' == 'true' and ('$(ZeroTarget)' == 'pico2' or '$(ZeroTarget)' == 'r4')"
          DependsOnTargets="ZeroCheckNativeLib;ZeroCheckNativeHost;ZeroNativeCommand;ZeroFSharpEntry"
          Inputs="@(Compile);@(ZeroLibraryReference);@(ZeroNativeInput);$(ZeroNativeArgsFile);@(ZeroFSharpNativeInput)"
          Outputs="$(ZeroNativeOutput);$(ZeroArmQemuOutput)">
    <PropertyGroup>
      <_ZeroDotnet>$(DOTNET_HOST_PATH)</_ZeroDotnet>
      <_ZeroDotnet Condition="'$(_ZeroDotnet)' == ''">dotnet</_ZeroDotnet>
      <_ZeroBitcode>&quot;$(_ZeroDotnet)&quot; &quot;$(ZeroSdkRoot)payload/tools/zero-bitcode/zero-bitcode.dll&quot;</_ZeroBitcode>
      <_ZeroArmBoard Condition="'$(ZeroTarget)' == 'pico2'">&quot;$(ZeroArmBoardElf)&quot; &quot;$(ZeroNativeOutput)&quot;</_ZeroArmBoard>
    </PropertyGroup>
    <Exec Condition="'$(OS)' != 'Windows_NT'" Command="test -x &quot;$(ZeroBflatDir)bflat&quot; || chmod +x &quot;$(ZeroBflatDir)bflat&quot;" />
    <MakeDir Directories="$(ZeroBitcodeDir);$([System.IO.Path]::GetDirectoryName('$(ZeroNativeOutput)'))" />
    <Message Text="bflat arguments: $(ZeroNativeArgs)" />
    <Exec Command="&quot;$(ZeroBflatExe)&quot; build-il @&quot;$(ZeroNativeArgsFile)&quot;" />
    <Exec Command="$(_ZeroBitcode) arm-bitcode &quot;$(ZeroBitcodeIl)&quot; &quot;$(ZeroBitcodeDir)bitcode&quot; &quot;$(ZeroNativeDir)System.Private.CoreLib.dll&quot; &quot;$(ZeroRefDir)BflatLib.dll&quot; @(_ZeroBitcodeReference->'&quot;%(Identity)&quot;', ' ') @(ZeroLibraryReference->'&quot;%(FullPath)&quot;', ' ') $(_ZeroIlcFeatures)" />
    <Exec Command="$(_ZeroBitcode) arm-link &quot;$(ZeroBitcodeDir)bitcode&quot; &quot;$([System.IO.Path]::GetFileNameWithoutExtension('$(ZeroBitcodeIl)'))&quot; &quot;$(ZeroNativeDir.TrimEnd('/'))&quot; $(ZeroTarget) &quot;$(ZeroArmQemuOutput)&quot; $(_ZeroArmBoard)" />
    <Message Importance="high" Text="$(MSBuildProjectName) -> $(ZeroNativeOutput)" />
    <Message Importance="high" Text="$(MSBuildProjectName) -> $(ZeroArmQemuOutput) (for QEMU: dotnet run)" Condition="'$(ZeroTarget)' == 'pico2'" />
  </Target>

  <!-- The framework is the SDK's: a TargetFramework set in the project would
       otherwise be ignored without a word. -->
  <Target Name="ZeroCheckTargetFramework" BeforeTargets="Restore;_CheckForInvalidConfigurationAndPlatform;DispatchToInnerBuilds"
          Condition="'$(_ZeroDotnet)' != 'true' and ('$(TargetFramework)' != '$(ZeroSdkTfm)' or '$(TargetFrameworks)' != '')">
    <Error Code="ZERO001"
           Text="A zero project's target framework is the SDK's ($(ZeroSdkTfm)); remove TargetFramework and TargetFrameworks from the project (TargetFramework is '$(TargetFramework)', TargetFrameworks '$(TargetFrameworks)')." />
  </Target>

  <!-- The .NET SDK: 10.0.400 or newer. Older ones fail later with errors that
       don't say why: 10.0.1xx and 10.0.2xx (the 1xx line is what Linux
       distributions package) can't find the zero03 target NuGet restored
       (NETSDK1005), and before 10.0.400 MSBuild can't run the C# compiler
       the project uses (Microsoft.Net.Compilers.Toolset). Before restore, so
       nothing is downloaded first; and before a build, for dotnet build
       no-restore. A preview's suffix (10.0.100-rc.2) is dropped for the compare. -->
  <Target Name="ZeroCheckDotnetSdk" BeforeTargets="Restore;_CheckForInvalidConfigurationAndPlatform"
          Condition="'$(NETCoreSdkVersion)' != '' and $([MSBuild]::VersionLessThan($([System.Text.RegularExpressions.Regex]::Replace('$(NETCoreSdkVersion)', '-.*', '')), '10.0.400'))">
    <Error Code="ZERO014"
           Text="ZeroCSharp.Sdk needs the .NET SDK 10.0.400 or newer; this build uses $(NETCoreSdkVersion) ($(DOTNET_HOST_PATH)). Linux distributions' dotnet packages are the older 10.0.1xx line: install Microsoft's .NET SDK beside it (https://dot.net/v1/dotnet-install.sh --channel 10.0) and put it first on PATH. Guide: https://onurgumus.github.io/zero-csharp/get-started/install-with-dotnet.html" />
  </Target>

  <!-- NativeLib: what it builds, and for which targets. Before the compile,
       so a mistake doesn't wait for it. -->
  <Target Name="ZeroCheckNativeLib" BeforeTargets="CoreCompile" Condition="'$(NativeLib)' != ''">
    <Error Condition="'$(NativeLib)' != 'Shared'"
           Text="NativeLib '$(NativeLib)' isn't supported: Zero C# builds shared libraries (NativeLib=Shared)." />
    <Error Condition="'$(OutputType)' != 'Library'"
           Text="NativeLib=Shared builds a native library: set OutputType to Library (it's '$(OutputType)')." />
    <Error Condition="'$(ZeroTarget)' != 'linux-x64' and '$(ZeroTarget)' != 'linux-arm64' and '$(ZeroTarget)' != 'win-x64' and '$(ZeroTarget)' != 'osx-arm64'"
           Text="A native library (NativeLib=Shared) builds for linux-x64, linux-arm64, win-x64 or osx-arm64; ZeroTarget '$(ZeroTarget)' has no shared libraries." />
  </Target>

  <!-- A native library is called through its exports, not compiled into
       another zero project: refuse a ProjectReference to one rather than
       quietly compiling its IL in. -->
  <!-- Only references that compile the other project's IL in: one for build
       order alone (ReferenceOutputAssembly=false) is fine, and a missing
       project stays MSBuild's warning. -->
  <Target Name="ZeroCheckProjectReferences" BeforeTargets="ResolveProjectReferences" Condition="'@(ProjectReference)' != ''">
    <ItemGroup>
      <_ZeroCompiledInReference Include="@(ProjectReference)" Condition="'%(ProjectReference.ReferenceOutputAssembly)' != 'false'" />
    </ItemGroup>
    <MSBuild Projects="@(_ZeroCompiledInReference)" Targets="ZeroNativeLibKind" SkipNonexistentTargets="true" SkipNonexistentProjects="true"
             Condition="'@(_ZeroCompiledInReference)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_ZeroReferencedNativeLibrary" />
    </MSBuild>
    <Error Condition="'@(_ZeroReferencedNativeLibrary)' != ''"
           Text="This project references a native library (NativeLib=Shared): @(_ZeroReferencedNativeLibrary->'%(Filename)', ', '). Call a native library through its exports ([DllImport]) from the program that loads it; remove the ProjectReference." />
  </Target>

  <!-- For ZeroCheckProjectReferences in the projects that reference this one. -->
  <Target Name="ZeroNativeLibKind" Returns="@(_ZeroNativeLibrarySelf)">
    <ItemGroup>
      <_ZeroNativeLibrarySelf Include="$(MSBuildProjectFullPath)" Condition="'$(ZeroNativeLibrary)' == 'true'" />
    </ItemGroup>
  </Target>

  <Target Name="ZeroCheckNativeHost">
    <Error Condition="'$(ZeroHostRid)' == '' and $([MSBuild]::IsOSPlatform('OSX'))"
           Text="Zero C# builds on Apple Silicon Macs, not Intel ones; build on an Apple Silicon Mac, Linux (x64 or arm64) or Windows x64." />
    <Error Condition="'$(ZeroHostRid)' == '' and !$([MSBuild]::IsOSPlatform('OSX'))"
           Text="Zero C# can't make native programs on this machine yet; build on Linux (x64 or arm64), Windows x64 or an Apple Silicon Mac." />
    <Error Condition="'$(ZeroTarget)' != 'linux-x64' and '$(ZeroTarget)' != 'linux-arm64' and '$(ZeroTarget)' != 'win-x64' and '$(ZeroTarget)' != 'osx-arm64' and '$(ZeroTarget)' != 'iossimulator-arm64' and '$(ZeroTarget)' != 'uefi-x64' and '$(ZeroTarget)' != 'uefi-arm64' and '$(ZeroTarget)' != 'c64' and '$(ZeroTarget)' != 'pico2' and '$(ZeroTarget)' != 'r4'"
           Text="ZeroTarget '$(ZeroTarget)' isn't supported. Use one of: linux-x64, linux-arm64, win-x64, osx-arm64, iossimulator-arm64, uefi-x64, uefi-arm64, c64, pico2, r4." />
    <Error Condition="'$(ZeroTarget)' == 'c64' and '$(ZeroHostRid)' == 'linux-arm64'"
           Text="ZeroTarget c64 builds on Linux x64, Windows x64 or an Apple Silicon Mac: llvm-mos, the compiler for the 6502, has no build for Linux arm64." />
    <Error Condition="'$(ZeroGpu)' != '' and '$(ZeroGpu)' != 'Metal' and '$(ZeroGpu)' != 'Cuda'"
           Text="ZeroGpu '$(ZeroGpu)' isn't supported. Use Metal (an Apple Silicon Mac's GPU) or Cuda (an NVIDIA GPU on Linux; experimental)." />
    <Error Condition="'$(ZeroGpu)' == 'Metal' and '$(ZeroTarget)' != 'osx-arm64'"
           Text="ZeroGpu=Metal builds for ZeroTarget osx-arm64: the kernels run on an Apple Silicon Mac's GPU, through Metal." />
    <Error Condition="'$(ZeroGpu)' == 'Metal' and '$(ZeroHostRid)' != 'osx-arm64'"
           Text="ZeroGpu=Metal builds on an Apple Silicon Mac: the kernels are compiled by Xcode's Metal compiler." />
    <Error Condition="'$(ZeroGpu)' == 'Metal' and '$(ZeroLanguage)' == 'FSharp'"
           Text="ZeroGpu=Metal takes kernels written in C#; an F# project can reference a C# library that has them." />
    <Error Condition="'$(ZeroGpu)' == 'Metal' and '$(ZeroNativeLibrary)' == 'true'"
           Text="ZeroGpu=Metal builds programs; a native library (NativeLib=Shared) can't have GPU kernels." />
    <Error Condition="'$(ZeroGpu)' == 'Cuda' and '$(ZeroTarget)' != 'linux-x64' and '$(ZeroTarget)' != 'linux-arm64'"
           Text="ZeroGpu=Cuda builds for ZeroTarget linux-x64 or linux-arm64: the kernels run on an NVIDIA GPU, through the CUDA driver on Linux." />
    <Error Condition="'$(ZeroGpu)' == 'Cuda' and '$(ZeroLanguage)' == 'FSharp'"
           Text="ZeroGpu=Cuda takes kernels written in C#; an F# project can reference a C# library that has them." />
    <Error Condition="'$(ZeroGpu)' == 'Cuda' and '$(ZeroNativeLibrary)' == 'true'"
           Text="ZeroGpu=Cuda builds programs; a native library (NativeLib=Shared) can't have GPU kernels." />
    <Error Condition="'$(ZeroOptimizeFor)' != 'None' and '$(ZeroOptimizeFor)' != 'Speed' and '$(ZeroOptimizeFor)' != 'Size'"
           Text="ZeroOptimizeFor '$(ZeroOptimizeFor)' isn't supported. Use one of: None, Speed, Size." />
  </Target>

  <!--
    C libraries the program links with (ZeroLinkLibrary, see Sdk.props): the
    project's own, its referenced projects', and its packages' (dotnet pack
    writes a library's names into the props file it packs). A name is found as
    a file here; a path is used as it is.
  -->
  <!-- This project's own: names as they are, paths (and RuntimeFile) made full,
       relative to this project. A path is anything with a slash, or a file
       next to the project. -->
  <Target Name="_ZeroLinkOwnItems">
    <ItemGroup>
      <_ZeroLinkOwn Include="@(ZeroLinkLibrary->'%(FullPath)')"
                    Condition="$([System.String]::Copy('%(Identity)').Contains('/')) or $([System.String]::Copy('%(Identity)').Contains('\')) or Exists('%(FullPath)')" />
      <_ZeroLinkOwn Include="@(ZeroLinkLibrary)"
                    Condition="!$([System.String]::Copy('%(Identity)').Contains('/')) and !$([System.String]::Copy('%(Identity)').Contains('\')) and !Exists('%(FullPath)')" />
      <_ZeroLinkOwn Condition="'%(_ZeroLinkOwn.RuntimeFile)' != ''">
        <RuntimeFile>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '%(_ZeroLinkOwn.RuntimeFile)'))))</RuntimeFile>
      </_ZeroLinkOwn>
    </ItemGroup>
  </Target>

  <!-- For the projects that reference this one, and for this project itself:
       its own and, through them, its references' references. -->
  <Target Name="ZeroLinkLibraryItems" DependsOnTargets="_ZeroLinkOwnItems" Returns="@(_ZeroLinkLibraryOut)">
    <ItemGroup>
      <_ZeroLinkRef Include="@(ProjectReference)" Condition="'%(ProjectReference.ReferenceOutputAssembly)' != 'false'" />
    </ItemGroup>
    <MSBuild Projects="@(_ZeroLinkRef)" Targets="ZeroLinkLibraryItems" SkipNonexistentTargets="true" SkipNonexistentProjects="true"
             Condition="'@(_ZeroLinkRef)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_ZeroLinkLibraryOut" />
    </MSBuild>
    <ItemGroup>
      <_ZeroLinkLibraryOut Include="@(_ZeroLinkOwn)" />
    </ItemGroup>
  </Target>

  <!-- Where a name is looked for: ZeroLibraryPath, then, building for the
       machine's own system, where its package manager puts libraries. -->
  <Target Name="_ZeroLinkLibrarySearch" DependsOnTargets="ZeroLinkLibraryItems">
    <PropertyGroup>
      <_ZeroLinkTriplet Condition="'$(ZeroTarget)' == 'linux-x64'">x86_64-linux-gnu</_ZeroLinkTriplet>
      <_ZeroLinkTriplet Condition="'$(ZeroTarget)' == 'linux-arm64'">aarch64-linux-gnu</_ZeroLinkTriplet>
      <_ZeroLinkSearch>$(ZeroLibraryPath)</_ZeroLinkSearch>
      <_ZeroLinkSearch Condition="'$(_ZeroLinkTriplet)' != '' and $([MSBuild]::IsOSPlatform('Linux'))">$(_ZeroLinkSearch);/usr/local/lib;/usr/lib/$(_ZeroLinkTriplet);/usr/lib64;/usr/lib</_ZeroLinkSearch>
      <_ZeroLinkSearch Condition="'$(ZeroTarget)' == 'osx-arm64' and $([MSBuild]::IsOSPlatform('OSX'))">$(_ZeroLinkSearch);/opt/homebrew/lib;/usr/local/lib</_ZeroLinkSearch>
    </PropertyGroup>
    <!-- Items for one target (ZeroTarget metadata) apply only to it; there, a
         path that binds a name's imports (DllImport) takes the name's place:
         a package's own Windows files, say, where Linux and macOS use the
         system's library. -->
    <ItemGroup>
      <_ZeroLinkForTarget Include="@(_ZeroLinkLibraryOut)"
                          Condition="'%(_ZeroLinkLibraryOut.ZeroTarget)' == '' or '%(_ZeroLinkLibraryOut.ZeroTarget)' == '$(ZeroTarget)'" />
      <_ZeroLinkPath Include="@(_ZeroLinkForTarget)" KeepDuplicates="false"
                     Condition="$([System.String]::Copy('%(Identity)').Contains('/')) or $([System.String]::Copy('%(Identity)').Contains('\'))" />
      <_ZeroLinkName Include="@(_ZeroLinkForTarget)" Exclude="@(_ZeroLinkPath);@(_ZeroLinkPath->'%(DllImport)')" KeepDuplicates="false" />
      <_ZeroLinkDir Include="$(_ZeroLinkSearch)" />
      <_ZeroLinkDir>
        <Slashed>$([MSBuild]::EnsureTrailingSlash('%(FullPath)'))</Slashed>
      </_ZeroLinkDir>
    </ItemGroup>
  </Target>

  <!-- Once per name: the first file found, in search order. -->
  <Target Name="_ZeroFindLinkLibrary" DependsOnTargets="_ZeroLinkLibrarySearch" Outputs="%(_ZeroLinkName.Identity)"
          Condition="'@(_ZeroLinkName)' != ''">
    <PropertyGroup>
      <_ZeroLinkNow>%(_ZeroLinkName.Identity)</_ZeroLinkNow>
      <_ZeroLinkFiles>lib$(_ZeroLinkNow).so</_ZeroLinkFiles>
      <_ZeroLinkFiles Condition="'$(_ZeroApple)' == 'true'">lib$(_ZeroLinkNow).tbd or lib$(_ZeroLinkNow).dylib</_ZeroLinkFiles>
      <_ZeroLinkFiles Condition="'$(ZeroTarget)' == 'win-x64' or '$(ZeroTarget)' == 'uefi-x64' or '$(ZeroTarget)' == 'uefi-arm64'">$(_ZeroLinkNow).lib</_ZeroLinkFiles>
    </PropertyGroup>
    <ItemGroup>
      <_ZeroLinkCandidate Remove="@(_ZeroLinkCandidate)" />
      <_ZeroLinkCandidate Include="@(_ZeroLinkDir->'%(Slashed)$(_ZeroLinkFiles)')" Condition="'$(_ZeroApple)' != 'true'" />
      <_ZeroLinkCandidate Include="@(_ZeroLinkDir->'%(Slashed)lib$(_ZeroLinkNow).tbd')" Condition="'$(_ZeroApple)' == 'true'" />
      <_ZeroLinkCandidate Include="@(_ZeroLinkDir->'%(Slashed)lib$(_ZeroLinkNow).dylib')" Condition="'$(_ZeroApple)' == 'true'" />
      <_ZeroLinkFound Remove="@(_ZeroLinkFound)" />
      <_ZeroLinkFound Include="@(_ZeroLinkCandidate)" Condition="Exists('%(Identity)')" />
    </ItemGroup>
    <PropertyGroup>
      <_ZeroLinkFirst>@(_ZeroLinkFound)</_ZeroLinkFirst>
      <_ZeroLinkFirst Condition="'$(_ZeroLinkFirst)' != ''">$(_ZeroLinkFirst.Split(';')[0])</_ZeroLinkFirst>
      <_ZeroLinkWhere>@(_ZeroLinkDir->'%(FullPath)', ', ')</_ZeroLinkWhere>
    </PropertyGroup>
    <Error Code="ZERO010" Condition="'$(_ZeroLinkFirst)' == '' and '$(_ZeroLinkWhere)' != ''"
           Text="The C library '$(_ZeroLinkNow)' (ZeroLinkLibrary) wasn't found for $(ZeroTarget): looked for $(_ZeroLinkFiles) in $(_ZeroLinkWhere). Install it, add its folder to ZeroLibraryPath, or give the file's path." />
    <Error Code="ZERO010" Condition="'$(_ZeroLinkFirst)' == '' and '$(_ZeroLinkWhere)' == ''"
           Text="The C library '$(_ZeroLinkNow)' (ZeroLinkLibrary) needs a folder for $(ZeroTarget): building for another system, only ZeroLibraryPath is searched. Set it to a folder with $(_ZeroLinkFiles) for $(ZeroTarget), or give the file's path." />
    <ItemGroup>
      <ZeroResolvedLinkLibrary Include="$(_ZeroLinkFirst)" DllImport="$(_ZeroLinkNow)" />
    </ItemGroup>
  </Target>

  <Target Name="ZeroResolveLinkLibraries" DependsOnTargets="_ZeroLinkLibrarySearch;_ZeroFindLinkLibrary">
    <Error Code="ZERO010" Condition="'@(_ZeroLinkPath)' != '' and !Exists('%(_ZeroLinkPath.FullPath)')"
           Text="The C library '%(_ZeroLinkPath.Identity)' (ZeroLinkLibrary) doesn't exist." />
    <ItemGroup>
      <ZeroResolvedLinkLibrary Include="@(_ZeroLinkPath)" />
      <!-- What the program loads at run time (RuntimeFile: a Windows DLL next
           to its import library), copied next to the program. -->
      <ZeroRuntimeFile Include="@(ZeroResolvedLinkLibrary->'%(RuntimeFile)')" Condition="'%(ZeroResolvedLinkLibrary.RuntimeFile)' != ''" KeepDuplicates="false" />
    </ItemGroup>
    <Error Code="ZERO010" Condition="'@(ZeroRuntimeFile)' != '' and !Exists('%(ZeroRuntimeFile.FullPath)')"
           Text="The run-time file '%(ZeroRuntimeFile.Identity)' (RuntimeFile of a ZeroLinkLibrary) doesn't exist." />
  </Target>

  <Target Name="ZeroCopyRuntimeFiles" AfterTargets="ZeroNativeBuild" BeforeTargets="IncrementalClean"
          Condition="'$(ZeroBuildsNative)' == 'true'" DependsOnTargets="ZeroNativeCommand">
    <Copy SourceFiles="@(ZeroRuntimeFile)" DestinationFolder="$([System.IO.Path]::GetDirectoryName('$(ZeroNativeOutput)'))"
          SkipUnchangedFiles="true" Condition="'@(ZeroRuntimeFile)' != ''">
      <Output TaskParameter="DestinationFiles" ItemName="FileWrites" />
    </Copy>
  </Target>

  <Target Name="ZeroNativeCommand" DependsOnTargets="ZeroNativeFiles;ZeroResolveLinkLibraries;_ZeroGpuMacSdk">
    <PropertyGroup>
      <!-- The SDK's own tool (sdk/ZeroCSharp.Bitcode), run by this dotnet. -->
      <_ZeroDotnet>$(DOTNET_HOST_PATH)</_ZeroDotnet>
      <_ZeroDotnet Condition="'$(_ZeroDotnet)' == ''">dotnet</_ZeroDotnet>
      <_ZeroBitcode>&quot;$(_ZeroDotnet)&quot; &quot;$(ZeroSdkRoot)payload/tools/zero-bitcode/zero-bitcode.dll&quot;</_ZeroBitcode>
      <!-- NuGetPackageRoot is the folder as configured, maybe without a trailing
           slash; package folders are lower-case. -->
      <ZeroBflatDir>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))zerocsharp.bflat.$(ZeroHostRid)/$(ZeroSdkVersion.ToLowerInvariant())/tools/bflat/</ZeroBflatDir>
      <ZeroBflatExe>$(ZeroBflatDir)bflat</ZeroBflatExe>
      <ZeroBflatExe Condition="'$(OS)' == 'Windows_NT'">$(ZeroBflatDir)bflat.exe</ZeroBflatExe>
      <ZeroLldExe>$(ZeroBflatDir)bin/lld</ZeroLldExe>
      <ZeroLldExe Condition="'$(OS)' == 'Windows_NT'">$(ZeroBflatDir)bin/lld.exe</ZeroLldExe>
      <ZeroNativeDir>$(ZeroSdkRoot)payload/native/$(ZeroTarget)/</ZeroNativeDir>
      <ZeroNativeOutput>$(OutDir)$(ZeroTargetFolder)$(AssemblyName)</ZeroNativeOutput>
      <ZeroNativeOutput Condition="'$(ZeroTarget)' == 'win-x64'">$(ZeroNativeOutput).exe</ZeroNativeOutput>
      <ZeroNativeOutput Condition="'$(ZeroTarget)' == 'uefi-x64' or '$(ZeroTarget)' == 'uefi-arm64'">$(ZeroNativeOutput).efi</ZeroNativeOutput>
      <ZeroNativeOutput Condition="'$(ZeroTarget)' == 'c64'">$(ZeroNativeOutput).prg</ZeroNativeOutput>
      <!-- ZeroGpu: the kernels' bitcode, AIR, metallib and objects, in obj/. -->
      <ZeroGpuDir>$(IntermediateOutputPath)gpu/</ZeroGpuDir>
      <ZeroGpuObjects Condition="'$(ZeroGpu)' == 'Metal'">$(ZeroGpuDir)kernels.o;$(ZeroGpuDir)metal.o</ZeroGpuObjects>
      <ZeroGpuSource Condition="'$(ZeroGpu)' == 'Metal'">$(ZeroSdkRoot)payload/native/gpu/metal.m</ZeroGpuSource>
      <ZeroGpuObjects Condition="'$(ZeroGpu)' == 'Cuda'">$(ZeroGpuDir)kernels.o</ZeroGpuObjects>
      <ZeroCudaArch Condition="'$(ZeroCudaArch)' == ''">sm_70</ZeroCudaArch>
      <!-- Microcontrollers: one runtime folder for both boards. The pico2's
           output is the real board's .uf2, with its .elf beside it and the
           QEMU build in qemu/; the r4's is the QEMU build. -->
      <ZeroNativeDir Condition="'$(ZeroTarget)' == 'pico2' or '$(ZeroTarget)' == 'r4'">$(ZeroSdkRoot)payload/native/arm/</ZeroNativeDir>
      <ZeroArmBoardElf>$(ZeroNativeOutput).elf</ZeroArmBoardElf>
      <ZeroArmQemuOutput Condition="'$(ZeroTarget)' == 'pico2'">$(OutDir)$(ZeroTargetFolder)qemu/$(AssemblyName).elf</ZeroArmQemuOutput>
      <ZeroArmQemuOutput Condition="'$(ZeroTarget)' == 'r4'">$(ZeroNativeOutput).elf</ZeroArmQemuOutput>
      <ZeroNativeOutput Condition="'$(ZeroTarget)' == 'pico2'">$(ZeroNativeOutput).uf2</ZeroNativeOutput>
      <ZeroNativeOutput Condition="'$(ZeroTarget)' == 'r4'">$(ZeroArmQemuOutput)</ZeroNativeOutput>
      <!-- The C64 and the microcontrollers: bflat's IL and NativeAOT-LLVM's
           bitcode, in obj/. -->
      <ZeroBitcodeDir>$(IntermediateOutputPath)$(ZeroTarget)/</ZeroBitcodeDir>
      <ZeroBitcodeIl>$(ZeroBitcodeDir)$(AssemblyName).dll</ZeroBitcodeIl>
      <!-- F#: bflat names the assembly it compiles after its file, and the
           C# entry program must not take the F# program's name. -->
      <ZeroBitcodeIl Condition="'$(ZeroLanguage)' == 'FSharp'">$(ZeroBitcodeDir)zero-native.dll</ZeroBitcodeIl>
      <!-- A native library: in native/, as NativeAOT puts it, which keeps a
           Windows .dll apart from the IL .dll of the same name. -->
      <ZeroNativeLibraryExtension Condition="'$(ZeroTarget)' == 'win-x64'">.dll</ZeroNativeLibraryExtension>
      <ZeroNativeLibraryExtension Condition="'$(ZeroTarget)' == 'osx-arm64'">.dylib</ZeroNativeLibraryExtension>
      <ZeroNativeLibraryExtension Condition="'$(ZeroTarget)' == 'linux-x64' or '$(ZeroTarget)' == 'linux-arm64'">.so</ZeroNativeLibraryExtension>
      <ZeroNativeOutput Condition="'$(ZeroNativeLibrary)' == 'true'">$(OutDir)$(ZeroTargetFolder)native/$(AssemblyName)$(ZeroNativeLibraryExtension)</ZeroNativeOutput>
      <!-- Where bflat writes the program. bflat names the assembly it compiles
           after that file: for F#, the C# entry program, which must not take
           the F# program's name, so it goes to obj/ and is copied. -->
      <ZeroBflatOutput>$(ZeroNativeOutput)</ZeroBflatOutput>
      <ZeroBflatOutput Condition="'$(ZeroLanguage)' == 'FSharp'">$(IntermediateOutputPath)zero-native/$(ZeroTarget)/zero-native$([System.IO.Path]::GetExtension('$(ZeroNativeOutput)'))</ZeroBflatOutput>
      <!-- F#: the C# that calls the F# entry point or exports (ZeroFSharpEntry),
           and for a Windows library the exports' .def and import library. -->
      <ZeroFSharpEntrySource>$(IntermediateOutputPath)zero-fsharp-entry.$(ZeroTarget).cs</ZeroFSharpEntrySource>
      <ZeroFSharpDefFile Condition="'$(ZeroLanguage)' == 'FSharp' and '$(ZeroNativeLibrary)' == 'true' and '$(ZeroTarget)' == 'win-x64'">$(IntermediateOutputPath)zero-fsharp-exports.def</ZeroFSharpDefFile>
      <ZeroFSharpImportLibrary>$([System.IO.Path]::ChangeExtension('$(ZeroNativeOutput)', '.lib'))</ZeroFSharpImportLibrary>
      <ZeroNativeArgsFile>$(IntermediateOutputPath)zero-native.args</ZeroNativeArgsFile>
      <ZeroNativeArgsFile Condition="'$(ZeroTargetFolder)' != ''">$(IntermediateOutputPath)zero-native.$(ZeroTarget).args</ZeroNativeArgsFile>
      <!-- macOS: bflat's object, then ld64.lld's command line. -->
      <ZeroNativeObject>$(IntermediateOutputPath)zero-native.$(ZeroTarget).o</ZeroNativeObject>
      <ZeroLinkArgsFile>$(IntermediateOutputPath)zero-link.$(ZeroTarget).args</ZeroLinkArgsFile>
      <!-- The macOS program's debug information stays in bflat's object (the
           program only points at it), so a missing object is a reason to rebuild. -->
      <ZeroDebugObject Condition="'$(_ZeroApple)' == 'true'">$(ZeroNativeObject)</ZeroDebugObject>
      <!-- ld64.lld's command line is an input too (ZeroStripSymbols changes
           it), on macOS only: elsewhere the file isn't written. -->
      <ZeroLinkArgsInput Condition="'$(_ZeroApple)' == 'true'">$(ZeroLinkArgsFile)</ZeroLinkArgsInput>
    </PropertyGroup>
    <ItemGroup>
      <!-- Zero libraries: every resolved reference that isn't zerocore or lib/
           (project references and packages; NuGet only lets zero ones in). -->
      <_ZeroFrameworkPath Include="@(Reference->'%(FullPath)')" Condition="'%(Reference.ZeroFramework)' == 'true'" />
      <ZeroLibraryReference Include="@(ReferencePath)" Exclude="@(_ZeroFrameworkPath)" />
      <!-- The C64: what NativeAOT-LLVM compiles besides the entry program,
           zerocore, lib/ and the zero libraries: for F#, the program's IL,
           FSharp.Core and the rest of ref/fsharp/. -->
      <_ZeroBitcodeReference Include="@(IntermediateAssembly->'%(FullPath)')" Condition="'$(ZeroLanguage)' == 'FSharp'" />
      <_ZeroBitcodeReference Include="@(Reference->'%(FullPath)')" Condition="'$(ZeroLanguage)' == 'FSharp' and '%(Reference.ZeroFramework)' == 'true' and '%(Reference.ZeroNative)' != 'false' and '%(Reference.Filename)' != 'BflatLib'" />
      <ZeroNativeInput Include="$(ZeroRefDir)*.dll;$(ZeroNativeDir)*" />
      <_ZeroArg Include="@(Compile->'&quot;%(FullPath)&quot;')" Condition="'$(ZeroLanguage)' == 'CSharp'" />
      <!-- The [LibraryImport] methods as [DllImport]s, from the SDK's generator (Sdk.props). -->
      <_ZeroLibraryImports Include="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(CompilerGeneratedFilesOutputPath)', 'ZeroCSharp.LibraryImport', 'ZeroCSharp.LibraryImport.LibraryImportGenerator', 'LibraryImports.g.cs'))"
                           Condition="'$(ZeroLanguage)' == 'CSharp' and '$(CompilerGeneratedFilesOutputPath)' != ''" />
      <_ZeroLibraryImports Remove="@(_ZeroLibraryImports)" Condition="!Exists('%(FullPath)')" />
      <ZeroNativeInput Include="@(_ZeroLibraryImports)" />
      <_ZeroArg Include="@(_ZeroLibraryImports->'&quot;%(FullPath)&quot;')" />
      <!-- F#: the C# entry program, the F# IL, and zerocore under its own name. -->
      <_ZeroArg Include="&quot;$([System.IO.Path]::GetFullPath('$(ZeroFSharpEntrySource)'))&quot;" Condition="'$(ZeroLanguage)' == 'FSharp'" />
      <_ZeroArg Include="@(IntermediateAssembly->'-r &quot;%(FullPath)&quot;')" Condition="'$(ZeroLanguage)' == 'FSharp'" />
      <_ZeroArg Include="-r &quot;$(ZeroRefDir)System.Private.CoreLib.dll&quot;" Condition="'$(ZeroLanguage)' == 'FSharp'" />
      <_ZeroArg Include="-r &quot;%(Reference.Identity)&quot;" Condition="'%(Reference.ZeroFramework)' == 'true' and '%(Reference.ZeroNative)' != 'false'" />
      <_ZeroArg Include="@(ZeroLibraryReference->'-r &quot;%(FullPath)&quot;')" />
      <_ZeroArg Include="--stdlib:none --no-reflection" Condition="'$(_ZeroBitcodeTarget)' != 'true'" />
      <_ZeroArg Include="--stdlib:none -O -o &quot;$(ZeroBitcodeIl)&quot;" Condition="'$(_ZeroBitcodeTarget)' == 'true'" />
      <!-- The language as the project sets it for the C# compiler. -->
      <_ZeroArg Include="--langversion $(LangVersion)" Condition="'$(LangVersion)' != '' and '$(ZeroLanguage)' == 'CSharp'" />
      <_ZeroArg Include="$(Features.Split(';'))" Condition="'$(Features)' != '' and '$(ZeroLanguage)' == 'CSharp'">
        <Prefix>--compiler-feature </Prefix>
      </_ZeroArg>
      <_ZeroArg Include="$(DefineConstants.Split(';'))" Condition="'$(DefineConstants)' != '' and '$(ZeroLanguage)' == 'CSharp'" >
        <Prefix>-d </Prefix>
      </_ZeroArg>
      <_ZeroDllImport Include="libc;libm.so.6;$(ZeroDllImports);@(ZeroResolvedLinkLibrary->'%(DllImport)')" KeepDuplicates="false" />
      <_ZeroArg Include="@(_ZeroDllImport->'-i %(Identity)', ' ')" Condition="'$(_ZeroBitcodeTarget)' != 'true'" />
      <!-- C libraries (ZeroLinkLibrary), where bflat links; macOS's go to ld64.lld below. -->
      <_ZeroArg Include="@(ZeroResolvedLinkLibrary->'--ldflags &quot;%(FullPath)&quot;', ' ')" Condition="'$(_ZeroApple)' != 'true' and '$(_ZeroBitcodeTarget)' != 'true' and '@(ZeroResolvedLinkLibrary)' != ''" />
      <!-- Linux: bflat links against its own C library, older than the one a
           system library was built with (SDL built on Ubuntu 24.04 calls
           pthread_create@GLIBC_2.34). lld would check the library's own
           references against bflat's and fail; the system's C library
           resolves them when the program runs. -->
      <_ZeroArg Include="--ldflags --allow-shlib-undefined" Condition="('$(ZeroTarget)' == 'linux-x64' or '$(ZeroTarget)' == 'linux-arm64') and '@(ZeroResolvedLinkLibrary)' != ''" />
      <!-- bflat's default operating system is the host's: named, so a Windows
           host builds Linux programs too. -->
      <_ZeroArg Include="--os linux" Condition="'$(ZeroTarget)' == 'linux-x64' or '$(ZeroTarget)' == 'linux-arm64'" />
      <_ZeroArg Include="--os macos -c" Condition="'$(_ZeroApple)' == 'true'" />
      <_ZeroArg Include="--target Shared" Condition="'$(ZeroTarget)' == 'osx-arm64' and '$(ZeroNativeLibrary)' == 'true'" />
      <_ZeroArg Include="--arch x64" Condition="'$(ZeroTarget)' == 'linux-x64' or '$(ZeroTarget)' == 'win-x64'" />
      <_ZeroArg Include="--arch arm64" Condition="'$(ZeroTarget)' == 'linux-arm64' or '$(_ZeroApple)' == 'true'" />
      <_ZeroArg Include="--ldflags &quot;$(ZeroNativeDir)zerocore.o&quot; --ldflags &quot;-z nostart-stop-gc&quot;" Condition="'$(ZeroTarget)' == 'linux-x64' or '$(ZeroTarget)' == 'linux-arm64'" />
      <_ZeroArg Include="--ldflags &quot;-z max-page-size=4096&quot;" Condition="'$(ZeroTarget)' == 'linux-arm64'" />
      <!-- ZeroGpu=Cuda: the kernels (PTX, in kernels.o) and CUDA's driver API
           behind lib/Gpu.cs's C functions (cuda.o), which opens libcuda. -->
      <_ZeroArg Include="--ldflags &quot;$([System.IO.Path]::GetFullPath('$(ZeroGpuDir)kernels.o'))&quot; --ldflags &quot;$(ZeroNativeDir)cuda.o&quot; --ldflags -ldl" Condition="'$(ZeroGpu)' == 'Cuda'" />
      <!-- A Linux native library: bflat links it -shared with a version script
           exporting the entry points; library.o's .init_array entry sets up
           zerocore when it loads. The module list's bounds stay hidden, and
           the soname lets C programs link against it by path (left out for a
           name with a space: bflat would pass it to lld as two words, and
           without one, a C program records the path it linked with). -->
      <_ZeroArg Include="--target Shared --ldflags &quot;$(ZeroNativeDir)library.o&quot; --ldflags &quot;-z start-stop-visibility=hidden&quot;"
                Condition="'$(ZeroNativeLibrary)' == 'true' and ('$(ZeroTarget)' == 'linux-x64' or '$(ZeroTarget)' == 'linux-arm64')" />
      <_ZeroArg Include="--ldflags --soname=$(AssemblyName).so"
                Condition="'$(ZeroNativeLibrary)' == 'true' and ('$(ZeroTarget)' == 'linux-x64' or '$(ZeroTarget)' == 'linux-arm64') and !$(AssemblyName.Contains(' '))" />
      <_ZeroArg Include="--os windows --ldflags /entry:zero_start --ldflags /wrap:getenv --ldflags /wrap:fopen --ldflags /wrap:remove --ldflags /wrap:mkdir --ldflags /wrap:rmdir --ldflags /wrap:rename --ldflags /wrap:getcwd --ldflags /wrap:chdir --ldflags /wrap:socket --ldflags /wrap:bind --ldflags /wrap:listen --ldflags /wrap:accept --ldflags /wrap:connect --ldflags /wrap:sendto --ldflags /wrap:recvfrom --ldflags /wrap:shutdown --ldflags /wrap:close --ldflags /wrap:setsockopt --ldflags /wrap:getsockopt --ldflags /wrap:getsockname --ldflags /wrap:getpeername --ldflags /wrap:getaddrinfo --ldflags /wrap:freeaddrinfo --ldflags /wrap:gethostname --ldflags &quot;$(ZeroNativeDir)start.obj&quot; --ldflags &quot;$(ZeroNativeDir)runtime.obj&quot; --ldflags &quot;$(ZeroNativeDir)zerocore.obj&quot;" Condition="'$(ZeroTarget)' == 'win-x64' and '$(ZeroNativeLibrary)' != 'true'" />
      <!-- A Windows native library: bflat links it /dll with a .def file of
           the entry points; zero_dll_start (win/library.c) sets up zerocore
           when it loads. -->
      <_ZeroArg Include="--os windows --target Shared --ldflags /entry:zero_dll_start --ldflags /wrap:getenv --ldflags /wrap:fopen --ldflags /wrap:remove --ldflags /wrap:mkdir --ldflags /wrap:rmdir --ldflags /wrap:rename --ldflags /wrap:getcwd --ldflags /wrap:chdir --ldflags /wrap:socket --ldflags /wrap:bind --ldflags /wrap:listen --ldflags /wrap:accept --ldflags /wrap:connect --ldflags /wrap:sendto --ldflags /wrap:recvfrom --ldflags /wrap:shutdown --ldflags /wrap:close --ldflags /wrap:setsockopt --ldflags /wrap:getsockopt --ldflags /wrap:getsockname --ldflags /wrap:getpeername --ldflags /wrap:getaddrinfo --ldflags /wrap:freeaddrinfo --ldflags /wrap:gethostname --ldflags &quot;$(ZeroNativeDir)runtime.obj&quot; --ldflags &quot;$(ZeroNativeDir)library.obj&quot; --ldflags &quot;$(ZeroNativeDir)zerocore.obj&quot;" Condition="'$(ZeroTarget)' == 'win-x64' and '$(ZeroNativeLibrary)' == 'true'" />
      <!-- UEFI: a program the firmware starts, with no operating system and no
           C library; the payload's efi/ objects and musl's libm stand in for it. -->
      <_ZeroArg Include="--os uefi --arch x64" Condition="'$(ZeroTarget)' == 'uefi-x64'" />
      <_ZeroArg Include="--os uefi --arch arm64" Condition="'$(ZeroTarget)' == 'uefi-arm64'" />
      <_ZeroUefiObject Include="start.obj;runtime.obj;machine.obj;stack.obj;zerocore.obj;libm.lib" />
      <_ZeroArg Include="@(_ZeroUefiObject->'--ldflags &quot;$(ZeroNativeDir)%(Identity)&quot;', ' ')" Condition="'$(ZeroTarget)' == 'uefi-x64' or '$(ZeroTarget)' == 'uefi-arm64'" />
      <_ZeroArg Include="-O0" Condition="'$(ZeroOptimizeFor)' == 'None' and '$(_ZeroBitcodeTarget)' != 'true'" />
      <_ZeroArg Include="-Os" Condition="'$(ZeroOptimizeFor)' == 'Size' and '$(_ZeroBitcodeTarget)' != 'true'" />
      <!-- ZeroStripSymbols: no debug information (macOS's stays in bflat's
           object, so the linker drops the symbols that point to it), and lld
           leaves the symbol table out of Linux programs. -->
      <_ZeroArg Include="--no-debug-info" Condition="'$(ZeroStripSymbols)' == 'true' and '$(_ZeroApple)' != 'true' and '$(_ZeroBitcodeTarget)' != 'true'" />
      <_ZeroArg Include="--ldflags --strip-all" Condition="'$(ZeroStripSymbols)' == 'true' and ('$(ZeroTarget)' == 'linux-x64' or '$(ZeroTarget)' == 'linux-arm64')" />
      <_ZeroArg Include="-m $(ZeroInstructionSet)" Condition="'$(ZeroInstructionSet)' != '' and '$(_ZeroBitcodeTarget)' != 'true'" />
      <!-- Feature switches (see zerocore's Switches): ILC drops what they guard. -->
      <_ZeroArg Include="--feature Zero.Globalization.IdeographOrders=false" Condition="'$(ZeroIdeographOrders)' == 'false' and '$(_ZeroBitcodeTarget)' != 'true'" />
      <_ZeroArg Include="-o &quot;$(ZeroBflatOutput)&quot;" Condition="'$(_ZeroApple)' != 'true' and '$(_ZeroBitcodeTarget)' != 'true'" />
      <_ZeroArg Include="-o &quot;$(ZeroNativeObject)&quot;" Condition="'$(_ZeroApple)' == 'true'" />
      <!-- ld64.lld (macOS 12 or newer, arm64: what bflat's objects ask for). zerocore's module list comes
           from the payload's objects (mac/start.c or mac/library.c, mac-arm64.S). Chained
           fixups: the classic lazy binding needs dyld_stub_binder's library.
           lld reads response files the GNU way, where a backslash escapes,
           so paths get forward slashes (which Windows takes too). -->
      <_ZeroLinkArg Include="-arch arm64 -platform_version macos 12.0 12.0 -fixup_chains -dead_strip" Condition="'$(ZeroTarget)' == 'osx-arm64'" />
      <!-- The iOS simulator: the same, for ZeroIosMinimum, with the payload's
           objects compiled for the simulator. -->
      <_ZeroLinkArg Include="-arch arm64 -platform_version ios-simulator $(ZeroIosMinimum) $(ZeroIosMinimum) -fixup_chains -dead_strip" Condition="'$(ZeroTarget)' == 'iossimulator-arm64'" />
      <_ZeroLinkArg Include="-x -S" Condition="'$(ZeroStripSymbols)' == 'true'" />
      <_ZeroLinkArg Include="&quot;$([System.String]::Copy('$([System.IO.Path]::GetFullPath('$(ZeroNativeObject)'))').Replace('\', '/'))&quot;" />
      <_ZeroLinkArg Include="&quot;$([System.String]::Copy('$(ZeroNativeDir)start.o').Replace('\', '/'))&quot;" Condition="'$(ZeroNativeLibrary)' != 'true'" />
      <!-- A macOS native library: a dylib exporting what bflat's exports file
           (written beside its object, one _name per line) lists; library.o's
           constructor sets up zerocore when it loads. -->
      <_ZeroLinkArg Include="-dylib -install_name &quot;@rpath/$(AssemblyName).dylib&quot; -exported_symbols_list &quot;$([System.String]::Copy('$([System.IO.Path]::GetFullPath('$([System.IO.Path]::ChangeExtension('$(ZeroNativeObject)', '.txt'))'))').Replace('\', '/'))&quot;" Condition="'$(ZeroNativeLibrary)' == 'true'" />
      <_ZeroLinkArg Include="&quot;$([System.String]::Copy('$(ZeroNativeDir)library.o').Replace('\', '/'))&quot;" Condition="'$(ZeroNativeLibrary)' == 'true'" />
      <_ZeroLinkArg Include="&quot;$([System.String]::Copy('$(ZeroNativeDir)runtime.o').Replace('\', '/'))&quot;" />
      <_ZeroLinkArg Include="&quot;$([System.String]::Copy('$(ZeroNativeDir)zerocore.o').Replace('\', '/'))&quot;" />
      <_ZeroLinkArg Include="&quot;$([System.String]::Copy('$(ZeroNativeDir)libSystem.tbd').Replace('\', '/'))&quot;" Condition="'$(ZeroGpu)' != 'Metal'" />
      <!-- ZeroGpu: the kernels (a metallib, in kernels.o), Metal behind lib/Gpu.cs
           (metal.o), and the frameworks that uses, from Xcode's macOS SDK, whose
           libSystem then stands in for the payload's. Xcode's ld links them
           (ZeroNativeBuild). -->
      <_ZeroLinkArg Include="&quot;$([System.String]::Copy('$([System.IO.Path]::GetFullPath('$(ZeroGpuDir)kernels.o'))').Replace('\', '/'))&quot;" Condition="'$(ZeroGpu)' == 'Metal'" />
      <_ZeroLinkArg Include="&quot;$([System.String]::Copy('$([System.IO.Path]::GetFullPath('$(ZeroGpuDir)metal.o'))').Replace('\', '/'))&quot;" Condition="'$(ZeroGpu)' == 'Metal'" />
      <_ZeroLinkArg Include="-syslibroot &quot;$(_ZeroMacSdk)&quot; -lSystem -lobjc -framework Metal -framework Foundation" Condition="'$(ZeroGpu)' == 'Metal'" />
      <!-- A project's own .tbd or .dylib (ZeroNativeInput), for libraries
           beyond libSystem, and its C libraries (ZeroLinkLibrary). -->
      <_ZeroMacLibrary Include="@(ZeroNativeInput->WithMetadataValue('Extension', '.tbd'));@(ZeroNativeInput->WithMetadataValue('Extension', '.dylib'))" />
      <_ZeroMacLibrary Include="@(ZeroResolvedLinkLibrary)" />
      <_ZeroMacLibrary Remove="$(ZeroNativeDir)libSystem.tbd" />
      <_ZeroMacLibrary>
        <Forward>$([System.String]::Copy('%(FullPath)').Replace('\', '/'))</Forward>
      </_ZeroMacLibrary>
      <_ZeroLinkArg Include="@(_ZeroMacLibrary->'&quot;%(Forward)&quot;')" />
      <_ZeroLinkArg Include="-o &quot;$([System.String]::Copy('$([System.IO.Path]::GetFullPath('$(ZeroNativeOutput)'))').Replace('\', '/'))&quot;" />
    </ItemGroup>
    <PropertyGroup>
      <ZeroNativeArgs>@(_ZeroArg->'%(Prefix)%(Identity)', ' ')</ZeroNativeArgs>
      <ZeroLinkArgs>@(_ZeroLinkArg, ' ')</ZeroLinkArgs>
    </PropertyGroup>
    <!-- The command line is an input too: changing a flag rebuilds. -->
    <WriteLinesToFile File="$(ZeroNativeArgsFile)" Lines="$(ZeroNativeArgs)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(ZeroLinkArgsFile)" Lines="$([MSBuild]::Escape('$(ZeroLinkArgs)'))" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Condition="'$(_ZeroApple)' == 'true'" />
    <!-- This build's program and command line, and the other targets' ones
         already there: IncrementalClean removes what earlier builds wrote and
         this one doesn't list, so programs for several targets stay. -->
    <ItemGroup>
      <FileWrites Include="$(ZeroNativeOutput);$(ZeroNativeArgsFile)" />
      <!-- F#: bflat's own copy of the program, and the C# entry program. -->
      <FileWrites Include="$(ZeroBflatOutput);$([System.IO.Path]::ChangeExtension('$(ZeroBflatOutput)', '.pdb'))" Condition="'$(ZeroLanguage)' == 'FSharp' and '$(_ZeroApple)' != 'true'" />
      <FileWrites Include="$(ZeroFSharpEntrySource)" Condition="'$(ZeroLanguage)' == 'FSharp'" />
      <FileWrites Include="$(ZeroNativeObject);$(ZeroLinkArgsFile)" Condition="'$(_ZeroApple)' == 'true'" />
      <FileWrites Include="$([System.IO.Path]::ChangeExtension('$(ZeroNativeObject)', '.txt'))" Condition="'$(ZeroTarget)' == 'osx-arm64' and '$(ZeroNativeLibrary)' == 'true'" />
      <FileWrites Include="@(ZeroNativeFile)" Condition="Exists('%(FullPath)')" />
    </ItemGroup>
  </Target>

  <!-- Every target's program and command line that a build may have made. -->
  <Target Name="ZeroNativeFiles">
    <ItemGroup>
      <_ZeroAnyTarget Include="linux-x64;linux-arm64;win-x64;osx-arm64;iossimulator-arm64;uefi-x64;uefi-arm64;c64;pico2;r4" />
      <ZeroNativeFile Include="$(OutDir)$(AssemblyName);$(OutDir)$(AssemblyName).exe" />
      <ZeroNativeFile Include="@(_ZeroAnyTarget->'$(OutDir)%(Identity)/$(AssemblyName)')" />
      <ZeroNativeFile Include="@(_ZeroAnyTarget->'$(OutDir)%(Identity)/$(AssemblyName).exe')" />
      <ZeroNativeFile Include="@(_ZeroAnyTarget->'$(OutDir)%(Identity)/$(AssemblyName).efi')" />
      <!-- The C64: the program, and the linker's copy with symbols. -->
      <ZeroNativeFile Include="$(OutDir)c64/$(AssemblyName).prg;$(OutDir)c64/$(AssemblyName).prg.elf" />
      <!-- The microcontrollers: the Pico 2's for the board and for QEMU, the
           Uno R4's for QEMU. -->
      <ZeroNativeFile Include="$(OutDir)pico2/$(AssemblyName).uf2;$(OutDir)pico2/$(AssemblyName).elf;$(OutDir)pico2/qemu/$(AssemblyName).elf;$(OutDir)r4/$(AssemblyName).elf" />
      <ZeroNativeFile Include="$(IntermediateOutputPath)zero-native*.args" />
      <!-- macOS: bflat's objects (the programs' debug information) and exports
           lists, and the linker's command lines. -->
      <ZeroNativeFile Include="$(IntermediateOutputPath)zero-native.*.o;$(IntermediateOutputPath)zero-native.*.txt;$(IntermediateOutputPath)zero-link.*.args" />
      <!-- Windows: the linker's PDB next to the program or library. -->
      <ZeroNativeFile Include="$(OutDir)$(AssemblyName).pdb" Condition="'$(OutputType)' != 'Library'" />
      <ZeroNativeFile Include="@(_ZeroAnyTarget->'$(OutDir)%(Identity)/$(AssemblyName).pdb')" />
      <ZeroNativeFile Include="@(_ZeroAnyTarget->'$(OutDir)%(Identity)/native/$(AssemblyName).pdb')" />
      <ZeroNativeFile Include="$(OutDir)native/$(AssemblyName).pdb" />
      <_ZeroNativeLibraryFile Include="$(AssemblyName).so;$(AssemblyName).dylib;$(AssemblyName).dll;$(AssemblyName).lib" />
      <ZeroNativeFile Include="@(_ZeroNativeLibraryFile->'$(OutDir)native/%(Identity)')" />
      <ZeroNativeFile Include="$(ZeroInteropSource)" Condition="'$(ZeroInteropSource)' != ''" />
      <ZeroNativeFile Include="$(ZeroInteropFSharpSource)" Condition="'$(ZeroInteropFSharpSource)' != ''" />
      <ZeroNativeFile Include="@(_ZeroAnyTarget->'$(OutDir)%(Identity)/native/$(AssemblyName).so')" />
      <ZeroNativeFile Include="@(_ZeroAnyTarget->'$(OutDir)%(Identity)/native/$(AssemblyName).dylib')" />
      <ZeroNativeFile Include="@(_ZeroAnyTarget->'$(OutDir)%(Identity)/native/$(AssemblyName).dll')" />
      <ZeroNativeFile Include="@(_ZeroAnyTarget->'$(OutDir)%(Identity)/native/$(AssemblyName).lib')" />
    </ItemGroup>
  </Target>

  <!-- dotnet clean (and Rebuild): every target's program and command line. -->
  <Target Name="ZeroClean" AfterTargets="CoreClean" DependsOnTargets="ZeroNativeFiles" Condition="'$(ZeroBuildsNative)' == 'true'">
    <Delete Files="@(ZeroNativeFile)" />
  </Target>

  <!-- dotnet run runs the native program, when it's for this machine. -->
  <PropertyGroup Condition="'$(OutputType)' != 'Library' and '$(ZeroTarget)' == '$(ZeroHostRid)' and '$(ZeroHostRid)' != ''">
    <RunCommand>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(OutDir)$(ZeroTargetFolder)', '$(AssemblyName)'))</RunCommand>
    <RunCommand Condition="'$(ZeroTarget)' == 'win-x64'">$(RunCommand).exe</RunCommand>
    <RunArguments>$(StartArguments)</RunArguments>
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <!--
    dotnet run of an iOS simulator program, on a Mac with Xcode's iOS platform:
    in a simulator, ZeroIosSimulator (a name or UDID) or one already booted or
    else the first iPhone, booted (the payload's boot.sh), through `xcrun simctl
    spawn`, as the repository's run.sh runs them: no app bundle. That
    starts programs in the simulated device's data directory, so the program
    starts through the payload's launch.c (linked once, in obj/), which moves
    to the project's folder first, as dotnet run does for the other targets.
  -->
  <Target Name="ZeroIosLauncher" AfterTargets="ZeroNativeBuild" BeforeTargets="IncrementalClean"
          Condition="'$(ZeroTarget)' == 'iossimulator-arm64' and '$(OutputType)' != 'Library'"
          DependsOnTargets="ZeroNativeCommand"
          Inputs="$(ZeroNativeDir)launch.o;$(ZeroNativeDir)libSystem.tbd" Outputs="$(ZeroIosLauncher)">
    <Exec Command="&quot;$(ZeroLldExe)&quot; -flavor darwin -arch arm64 -platform_version ios-simulator $(ZeroIosMinimum) $(ZeroIosMinimum) -fixup_chains &quot;$([System.String]::Copy('$(ZeroNativeDir)launch.o').Replace('\', '/'))&quot; &quot;$([System.String]::Copy('$(ZeroNativeDir)libSystem.tbd').Replace('\', '/'))&quot; -o &quot;$([System.String]::Copy('$([System.IO.Path]::GetFullPath('$(ZeroIosLauncher)'))').Replace('\', '/'))&quot;" />
    <ItemGroup>
      <FileWrites Include="$(ZeroIosLauncher)" />
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <ZeroIosLauncher>$(IntermediateOutputPath)zero-ios-launch</ZeroIosLauncher>
  </PropertyGroup>
  <!-- dotnet run calls ComputeRunArguments before it reads RunCommand. -->
  <Target Name="ZeroIosRunArguments" BeforeTargets="ComputeRunArguments"
          Condition="'$(ZeroTarget)' == 'iossimulator-arm64' and '$(OutputType)' != 'Library'">
    <Error Condition="!$([MSBuild]::IsOSPlatform('OSX'))"
           Text="An iossimulator-arm64 program runs in the iOS simulator, on a Mac with Xcode: copy $(OutDir)$(ZeroTargetFolder)$(AssemblyName) there and run it with xcrun simctl spawn." />
    <Exec Command="/bin/sh &quot;$(ZeroSdkRoot)payload/native/iossimulator-arm64/boot.sh&quot; &quot;$(ZeroIosSimulator)&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ZeroIosDevice" />
    </Exec>
    <PropertyGroup>
      <RunCommand>xcrun</RunCommand>
      <RunArguments>simctl spawn $(_ZeroIosDevice) &quot;$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(ZeroIosLauncher)'))&quot; &quot;$(MSBuildProjectDirectory)&quot; &quot;$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(OutDir)$(ZeroTargetFolder)', '$(AssemblyName)'))&quot; $(StartArguments)</RunArguments>
      <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    </PropertyGroup>
  </Target>

  <!-- dotnet run of a microcontroller program: in QEMU (qemu-system-arm), on
       the board that stands in for the real one, as the repository's run.sh
       runs them. Output, input and the exit code go through semihosting; a
       terminal's typing reaches the program through the console. -->
  <PropertyGroup Condition="'$(OutputType)' != 'Library' and ('$(ZeroTarget)' == 'pico2' or '$(ZeroTarget)' == 'r4')">
    <_ZeroQemuMachine Condition="'$(ZeroTarget)' == 'pico2'">mps2-an505</_ZeroQemuMachine>
    <_ZeroQemuMachine Condition="'$(ZeroTarget)' == 'r4'">mps2-an386</_ZeroQemuMachine>
    <_ZeroQemuProgram Condition="'$(ZeroTarget)' == 'pico2'">$(OutDir)pico2/qemu/$(AssemblyName).elf</_ZeroQemuProgram>
    <_ZeroQemuProgram Condition="'$(ZeroTarget)' == 'r4'">$(OutDir)r4/$(AssemblyName).elf</_ZeroQemuProgram>
    <RunCommand>qemu-system-arm</RunCommand>
    <RunArguments>-M $(_ZeroQemuMachine) -nographic -serial none -monitor none -chardev stdio,id=console -semihosting-config enable=on,target=native,chardev=console,arg=$(AssemblyName.Replace(' ', '_').Replace(',', ',,')) -kernel &quot;$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_ZeroQemuProgram)'))&quot;</RunArguments>
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <!-- dotnet publish ships the native program, not the IL it was built beside. -->
  <Target Name="ZeroPublishNative" AfterTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="ZeroNativeCommand" Condition="'$(ZeroBuildsNative)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == '$(TargetFileName)' or '%(ResolvedFileToPublish.RelativePath)' == '$(TargetName).pdb'" />
      <ResolvedFileToPublish Include="$(ZeroNativeOutput)" RelativePath="$([System.IO.Path]::GetFileName('$(ZeroNativeOutput)'))" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="@(ZeroRuntimeFile)" RelativePath="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- dotnet pack of a library: the dll in lib/<framework>/, and
       build/<id>.props (buildTransitive/ too) naming the SDK version that
       built it, which ZeroCheckLibraryVersions reads in the programs using it. -->
  <Target Name="ZeroPackDll" BeforeTargets="_GetPackageFiles" DependsOnTargets="_ZeroLinkOwnItems" Condition="'$(OutputType)' == 'Library' and '$(ZeroNativeLibrary)' != 'true'">
    <!-- The library's C libraries (ZeroLinkLibrary) go in the props too: names
         as they are; files inside the project packed in native/<target>/
         (native/any/ without ZeroTarget), with their RuntimeFile, and named
         from where the props file lands. Files from a package this one
         depends on come with that package; any other file is this machine's,
         and isn't packed (ZERO011). -->
    <ItemGroup>
      <_ZeroPackLinkName Include="@(_ZeroLinkOwn)" KeepDuplicates="false"
                         Condition="!$([System.String]::Copy('%(Identity)').Contains('/')) and !$([System.String]::Copy('%(Identity)').Contains('\'))" />
      <_ZeroPackLinkFile Include="@(_ZeroLinkOwn)" Exclude="@(_ZeroPackLinkName)"
                         Condition="$([System.String]::Copy('%(FullPath)').StartsWith('$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)'))'))" />
      <_ZeroPackLinkOutside Include="@(_ZeroLinkOwn)" Exclude="@(_ZeroPackLinkName);@(_ZeroPackLinkFile)"
                            Condition="'$(NuGetPackageRoot)' == '' or !$([System.String]::Copy('%(FullPath)').StartsWith('$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))'))" />
      <_ZeroPackLinkFile>
        <Folder>native/%(_ZeroPackLinkFile.ZeroTarget)/</Folder>
      </_ZeroPackLinkFile>
      <_ZeroPackLinkFile Condition="'%(_ZeroPackLinkFile.ZeroTarget)' == ''">
        <Folder>native/any/</Folder>
      </_ZeroPackLinkFile>
      <_ZeroPackLinkFile>
        <Packed>%24(MSBuildThisFileDirectory)../%(_ZeroPackLinkFile.Folder)%(_ZeroPackLinkFile.Filename)%(_ZeroPackLinkFile.Extension)</Packed>
      </_ZeroPackLinkFile>
      <_ZeroPackLinkFile Condition="'%(_ZeroPackLinkFile.RuntimeFile)' != ''">
        <PackedRuntime>%24(MSBuildThisFileDirectory)../%(_ZeroPackLinkFile.Folder)$([System.IO.Path]::GetFileName('%(_ZeroPackLinkFile.RuntimeFile)'))</PackedRuntime>
      </_ZeroPackLinkFile>
      <None Include="@(_ZeroPackLinkFile)" Pack="true" PackagePath="%(_ZeroPackLinkFile.Folder)" />
      <None Include="@(_ZeroPackLinkFile->'%(RuntimeFile)')" Pack="true" PackagePath="%(_ZeroPackLinkFile.Folder)" Condition="'%(_ZeroPackLinkFile.RuntimeFile)' != ''" />
    </ItemGroup>
    <Error Code="ZERO011" Condition="'@(_ZeroPackLinkFile)' != '' and '%(_ZeroPackLinkFile.RuntimeFile)' != '' and !$([System.String]::Copy('%(_ZeroPackLinkFile.RuntimeFile)').StartsWith('$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)'))'))"
           Text="RuntimeFile '%(_ZeroPackLinkFile.RuntimeFile)' of ZeroLinkLibrary '%(_ZeroPackLinkFile.Identity)' is outside the project, so it can't be packed with it: put it in the project's folder." />
    <Warning Code="ZERO011" Condition="'@(_ZeroPackLinkOutside)' != ''"
             Text="ZeroLinkLibrary '%(_ZeroPackLinkOutside.Identity)' is outside the project, so it isn't packed: programs using the package won't link with it. Use the library's name, or put the file in the project's folder to pack it." />
    <PropertyGroup>
      <_ZeroBuiltWithProps>$(IntermediateOutputPath)zero-pack/$(PackageId).props</_ZeroBuiltWithProps>
      <_ZeroPackLinkItems>@(_ZeroPackLinkName->'&lt;ZeroLinkLibrary Include=&quot;%(Identity)&quot; ZeroTarget=&quot;%(ZeroTarget)&quot; /&gt;', '')</_ZeroPackLinkItems>
      <_ZeroPackLinkItems>$(_ZeroPackLinkItems)@(_ZeroPackLinkFile->'&lt;ZeroLinkLibrary Include=&quot;%(Packed)&quot; DllImport=&quot;%(DllImport)&quot; ZeroTarget=&quot;%(ZeroTarget)&quot; RuntimeFile=&quot;%(PackedRuntime)&quot; /&gt;', '')</_ZeroPackLinkItems>
    </PropertyGroup>
    <WriteLinesToFile File="$(_ZeroBuiltWithProps)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="&lt;Project&gt;&lt;ItemGroup&gt;&lt;ZeroLibraryBuiltWith Include=&quot;$(PackageId)&quot; SdkVersion=&quot;$(ZeroSdkVersion)&quot; /&gt;$(_ZeroPackLinkItems)&lt;/ItemGroup&gt;&lt;/Project&gt;" />
    <ItemGroup>
      <None Include="$(TargetPath)" Pack="true" PackagePath="lib/$(ZeroSdkTfm)/" />
      <None Include="$(_ZeroBuiltWithProps)" Pack="true" PackagePath="build/;buildTransitive/" />
      <FileWrites Include="$(_ZeroBuiltWithProps)" />
    </ItemGroup>
  </Target>

  <!-- A library built by a newer SDK may use members this one's zerocore or
       lib/ lack (the framework only changes when the format breaks). Versions
       are compared without a prerelease suffix. -->
  <Target Name="ZeroCheckLibraryVersions" BeforeTargets="CoreCompile" Condition="'@(ZeroLibraryBuiltWith)' != ''">
    <PropertyGroup>
      <_ZeroSdkPlainVersion>$(ZeroSdkVersion.Split('-')[0])</_ZeroSdkPlainVersion>
    </PropertyGroup>
    <ItemGroup>
      <_ZeroNewerLibrary Include="@(ZeroLibraryBuiltWith)"
                         Condition="$([MSBuild]::VersionGreaterThan($([System.String]::Copy('%(ZeroLibraryBuiltWith.SdkVersion)').Split('-')[0]), $(_ZeroSdkPlainVersion)))" />
    </ItemGroup>
    <Error Code="ZERO002" Condition="'@(_ZeroNewerLibrary)' != ''"
           Text="%(_ZeroNewerLibrary.Identity) was built with ZeroCSharp.Sdk %(_ZeroNewerLibrary.SdkVersion), newer than this project's $(ZeroSdkVersion): update ZeroCSharp.Sdk in the project's Sdk attribute." />
  </Target>

  <!--
    F#: the C# that bflat compiles with the F# IL, written by the task in
    Sdk/ZeroFSharpNative.cs.txt (not .cs: a project whose packages folder is
    inside it would compile it with its own sources):
    a program's Main, which calls the F# entry point, or a native library's
    exports, which call the F# [<UnmanagedCallersOnly(EntryPoint = ...)>]
    functions. Read from the F# compiler's IL.
  -->
  <Target Name="ZeroFSharpEntry" Condition="'$(ZeroLanguage)' == 'FSharp' and '$(ZeroBuildsNative)' == 'true'"
          DependsOnTargets="ZeroNativeCommand"
          Inputs="@(IntermediateAssembly)" Outputs="$(ZeroFSharpEntrySource);$(ZeroFSharpDefFile)">
    <ZeroFSharpNative Assembly="@(IntermediateAssembly->'%(FullPath)')" Source="$(ZeroFSharpEntrySource)"
                      Library="$(ZeroNativeLibrary)" DefFile="$(ZeroFSharpDefFile)" DllName="$(AssemblyName).dll"
                      NoArguments="$([System.String]::Equals('$(ZeroTarget)', 'c64'))" />
  </Target>
  <ItemGroup Condition="'$(ZeroLanguage)' == 'FSharp'">
    <ZeroFSharpNativeInput Include="@(IntermediateAssembly)" />
  </ItemGroup>
  <!--
    F#, programs and libraries alike: ZERO006 for an Arena.Scratch callback
    whose state is a ref struct, which C# checks with `scoped` and F# can't
    (Sdk/ZeroFSharpNative.cs.txt, CheckScratchStates), and the warning ZERO007
    for a call to a member C# marks `unsafe` from a function without
    [<Safety>] or [<RequiresUnsafe>] (CheckUnsafeCalls). Read from the IL, with
    the references for the types and members it names from other assemblies.
  -->
  <Target Name="ZeroFSharpCheck" Condition="'$(ZeroLanguage)' == 'FSharp'" AfterTargets="CoreCompile"
          Inputs="@(IntermediateAssembly);@(ReferencePath)" Outputs="$(IntermediateOutputPath)zero-fsharp-check.stamp">
    <ZeroFSharpNative Assembly="@(IntermediateAssembly->'%(FullPath)')" Check="true" References="@(ReferencePath)">
      <Output TaskParameter="Clean" PropertyName="_ZeroFSharpCheckClean" />
    </ZeroFSharpNative>
    <!-- Checked, until it changes, only if nothing was reported: warnings are
         shown in every build until they're dealt with (and one made an error
         by WarningsAsErrors fails every build, not just the first). -->
    <Touch Files="$(IntermediateOutputPath)zero-fsharp-check.stamp" AlwaysCreate="true" Condition="'$(_ZeroFSharpCheckClean)' == 'true'" />
    <Delete Files="$(IntermediateOutputPath)zero-fsharp-check.stamp" Condition="'$(_ZeroFSharpCheckClean)' != 'true'" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)zero-fsharp-check.stamp" />
    </ItemGroup>
  </Target>
  <UsingTask TaskName="ZeroFSharpNative" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)ZeroFSharpNative.cs.txt" />
    </Task>
  </UsingTask>

  <!--
    A native library's bindings for .NET, C# and F# libraries alike: the code
    that declares its exports with [LibraryImport] (or [DllImport]) and copies the structs and enums
    they use (Sdk/ZeroFSharpNative.cs.txt, WriteInterop), in C# in
    bin/<AssemblyName>.Interop.cs and in F# in bin/<AssemblyName>.Interop.fs,
    one of each for every configuration and target.
    Written only when it changes, so a program that compiles it in isn't
    rebuilt for nothing. ZeroInteropClass names the class (Namespace.Class;
    the assembly's name by default); ZeroInterop=false turns it off.
  -->
  <PropertyGroup Condition="'$(ZeroNativeLibrary)' == 'true'">
    <ZeroInteropSource Condition="'$(ZeroInteropSource)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseOutputPath)', '$(AssemblyName).Interop.cs'))</ZeroInteropSource>
    <ZeroInteropFSharpSource Condition="'$(ZeroInteropFSharpSource)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseOutputPath)', '$(AssemblyName).Interop.fs'))</ZeroInteropFSharpSource>
  </PropertyGroup>
  <Target Name="ZeroInterop" AfterTargets="CoreCompile" Condition="'$(ZeroNativeLibrary)' == 'true' and '$(ZeroInterop)' != 'false'">
    <ZeroFSharpNative Assembly="@(IntermediateAssembly->'%(FullPath)')" Interop="$(ZeroInteropSource)" InteropFSharp="$(ZeroInteropFSharpSource)"
                      LibraryName="$(AssemblyName)" InteropClass="$(ZeroInteropClass)" />
  </Target>

  <!--
    For a .NET program's ProjectReference to a native library, with
    Targets="ZeroNativeLibraryFiles" OutputItemType="Content": builds the
    library and gives back the file to copy next to the program (and into its
    publish folder), which .NET then finds by name.
  -->
  <Target Name="ZeroNativeLibraryFiles" DependsOnTargets="Build;_ZeroNativeLibraryForProgram" Returns="@(_ZeroNativeLibraryForProgram)"
          Condition="'$(ZeroNativeLibrary)' == 'true'" />
  <Target Name="_ZeroNativeLibraryForProgram" DependsOnTargets="ZeroNativeCommand" Condition="'$(ZeroNativeLibrary)' == 'true'">
    <ItemGroup>
      <!-- A full path: the program resolves it from its own folder. -->
      <_ZeroNativeLibraryForProgram Include="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(ZeroNativeOutput)'))"
                                    Link="$([System.IO.Path]::GetFileName('$(ZeroNativeOutput)'))"
                                    TargetPath="$([System.IO.Path]::GetFileName('$(ZeroNativeOutput)'))"
                                    CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <!--
    Visual Studio builds the solution's projects itself and asks a reference
    only for GetTargetPath, ignoring its Targets metadata: the program would
    get the library's IL .dll as Content, not copied. There the library
    answers with its native file instead, with the same copy metadata.
  -->
  <Target Name="_ZeroNativeLibraryTargetPathInVisualStudio" AfterTargets="GetTargetPathWithTargetPlatformMoniker"
          DependsOnTargets="_ZeroNativeLibraryForProgram"
          Condition="'$(ZeroNativeLibrary)' == 'true' and '$(BuildingInsideVisualStudio)' == 'true'">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Remove="@(TargetPathWithTargetPlatformMoniker)" />
      <TargetPathWithTargetPlatformMoniker Include="@(_ZeroNativeLibraryForProgram)" />
    </ItemGroup>
  </Target>

  <!-- A Windows F# native library: bflat's import library names its own DLL
       (zero-native.dll, see ZeroBflatOutput), so it's made again from the
       exports, naming the project's. lld as lib.exe: /lib first. -->
  <Target Name="ZeroFSharpImportLibrary" AfterTargets="ZeroNativeBuild"
          Condition="'$(ZeroLanguage)' == 'FSharp' and '$(ZeroNativeLibrary)' == 'true' and '$(ZeroTarget)' == 'win-x64'"
          Inputs="$(ZeroFSharpDefFile)" Outputs="$(ZeroFSharpImportLibrary)">
    <Exec Command="&quot;$(ZeroLldExe)&quot; -flavor link /lib /machine:x64 /def:&quot;$(ZeroFSharpDefFile)&quot; /out:&quot;$(ZeroFSharpImportLibrary)&quot;" />
    <ItemGroup>
      <FileWrites Include="$(ZeroFSharpImportLibrary)" />
    </ItemGroup>
  </Target>
</Project>
