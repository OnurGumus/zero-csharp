<!--
  ZeroTarget=dotnet: a zero project as an ordinary .NET program (Sdk.props).

  lib/ is compiled into the program as source (payload/dotnet/): its Task,
  timers, streams, sockets and Console have the names of .NET's, and only
  types of the program's own assembly can take the place of .NET's (the
  compiler warns, CS0436, and uses them; the same types in a referenced
  assembly would be an ambiguity, CS0433). So the program behaves as in zero
  mode: Task.Run starts a fiber, a socket lets the other fibers run.
  Cryptography and TLS are .NET's own, which are the platform's (SslStream
  is .NET's, running over lib/'s sockets: the payload's TlsBridge.cs).

  F# projects reference lib/ as one assembly instead (ZeroCSharp.Dotnet:
  ZeroLib.dll, and zero's task/async/MailboxProcessor as FSharp.Control.dll).
  F#, unlike C#, takes a referenced assembly's type over .NET's of the same
  name, and an F# library and the F# program using it then share lib/'s
  types: the same Task, Fiber and Channel. FSharp.Core is .NET's own.

  With ZeroDotnetTypes=Net the program gets .NET's own Task, streams and
  sockets instead, to hand to other .NET code: lib/'s files that have those
  names are left out, and the rest of lib/ is compiled in as before.

  What differs from zero mode is in the repository's dotnet/ folder
  (README.md, known-differences.txt): objects are the garbage collector's,
  not an arena's; a throw runs catch and finally blocks on its way to
  Catch.Run; fibers are threads that take turns.

  And objects move. In zero mode an object stays where it was made, so code
  may keep its address (Unsafe.AsPointer on a field, a pointer kept after
  `fixed`, a reference stored as a number). .NET's collector moves objects,
  and such an address then points at other memory: the program compiles, and
  fails rarely. lib/ was changed where it did this; a project's own code is
  the project's to check. Running the program with ZERO_GC_STRESS=1 in the
  environment makes the collector move everything every few milliseconds,
  which shows most of it (dotnet/README.md).
-->
<Project>
  <!-- The files of lib/ a program leaves out to use .NET's own types (ZeroLibOwnTypes). -->
  <Import Project="$(ZeroSdkRoot)payload/dotnet/NetTypes.props" />

  <PropertyGroup>
    <!-- Nothing native is built: .NET runs the IL. -->
    <ZeroBuildsNative>false</ZeroBuildsNative>
    <!-- Zero (the default): lib/'s own Task, timers, streams, sockets and
         Console, so the program behaves as in zero mode. Net: .NET's own,
         for a program that hands them to other .NET code (a NuGet library
         that takes a Task or a Stream). Net is further from zero mode:
         Task.Run is .NET's thread pool, in parallel with the program, and a
         fiber that blocks in a .NET socket blocks the others. An await's
         continuation still comes back to the program's own thread. -->
    <ZeroDotnetTypes Condition="'$(ZeroDotnetTypes)' == ''">Zero</ZeroDotnetTypes>
    <DefineConstants>$(DefineConstants);ZERO_DOTNET</DefineConstants>
    <DefineConstants Condition="'$(ZeroDotnetTypes)' == 'Net'">$(DefineConstants);ZERO_DOTNET_BCL</DefineConstants>
    <!-- CS0436: lib/'s types in place of .NET's, at every use. (Not CS8500,
         a pointer to something with references in it: lib/'s own are
         answered for in zero.editorconfig, and in the project's code the
         warning is worth having here, see below.) With .NET's own types
         nothing of lib/'s has a .NET type's name: there CS0436 is an error. -->
    <NoWarn Condition="'$(ZeroDotnetTypes)' != 'Net'">$(NoWarn);CS0436</NoWarn>
    <WarningsAsErrors Condition="'$(ZeroDotnetTypes)' == 'Net'">$(WarningsAsErrors);CS0436</WarningsAsErrors>
    <!-- .NET's invariant globalization mode unless the project says otherwise:
         strings compare by character code, as in zero mode, and no ICU is
         needed. A program that names cultures sets it to false (ICU: named
         cultures as zerocore's, but strings in the invariant culture compare
         by language rules). -->
    <InvariantGlobalization Condition="'$(InvariantGlobalization)' == ''">true</InvariantGlobalization>
    <ZeroDotnetDir>$(ZeroSdkRoot)payload/dotnet/</ZeroDotnetDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(ZeroLanguage)' == 'CSharp'">
    <Compile Include="$(ZeroDotnetDir)lib/*.cs" Link="Zero/lib/%(Filename)%(Extension)" Visible="false" />
    <Compile Include="$(ZeroDotnetDir)compat/*.cs" Link="Zero/compat/%(Filename)%(Extension)" Visible="false" />
    <Compile Include="$(ZeroDotnetDir)compat-zero/*.cs" Link="Zero/compat/%(Filename)%(Extension)" Visible="false"
             Condition="'$(ZeroDotnetTypes)' != 'Net'" />
    <Compile Include="$(ZeroDotnetDir)compat-net/*.cs" Link="Zero/compat/%(Filename)%(Extension)" Visible="false"
             Condition="'$(ZeroDotnetTypes)' == 'Net'" />
    <Compile Remove="@(ZeroLibOwnTypes->'$(ZeroDotnetDir)lib/%(Identity).cs')" Condition="'$(ZeroDotnetTypes)' == 'Net'" />
  </ItemGroup>
  <!-- F#: lib/ built for .NET, from ZeroCSharp.Dotnet, downloaded rather than
       referenced as a package, so that an F# library built with it doesn't
       depend on it (the program using the library references it itself). -->
  <PropertyGroup Condition="'$(ZeroLanguage)' == 'FSharp'">
    <ZeroDotnetLibDir Condition="'$(NuGetPackageRoot)' != ''">$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))zerocsharp.dotnet/$(ZeroSdkVersion.ToLowerInvariant())/dotnet/</ZeroDotnetLibDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(ZeroLanguage)' == 'FSharp'">
    <PackageDownload Include="ZeroCSharp.Dotnet" Version="[$(ZeroSdkVersion)]" />
    <Reference Include="$(ZeroDotnetLibDir)ZeroLib.dll" Condition="'$(ZeroDotnetLibDir)' != ''" />
    <Reference Include="$(ZeroDotnetLibDir)FSharp.Control.dll" Condition="'$(ZeroDotnetLibDir)' != ''" />
  </ItemGroup>
  <ItemGroup>
    <!-- lib/Gpu.cs and the tensor samples use it; zerocore has its own. -->
    <PackageReference Include="System.Numerics.Tensors" Version="11.0.0" IsImplicitlyDefined="true" />
    <!-- macOS: glibc's names and layouts, which lib/ calls (dotnet/native). Linux has glibc. -->
    <None Include="$(ZeroDotnetDir)native/osx/libzerocompat.dylib" Link="libzerocompat.dylib" Visible="false"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) and Exists('$(ZeroDotnetDir)native/osx/libzerocompat.dylib')" />
  </ItemGroup>

  <!-- The payload's own warnings stay out of the project's build: its
       zero.editorconfig turns them off for its folder only, so the project's
       code keeps every warning. (NuGet leaves a file named .editorconfig out
       of a package, hence the name.) -->
  <Target Name="ZeroDotnetAnalyzerConfig" BeforeTargets="GenerateMSBuildEditorConfigFile;CoreCompile">
    <ItemGroup>
      <EditorConfigFiles Include="$(ZeroDotnetDir)zero.editorconfig" />
    </ItemGroup>
  </Target>

  <!-- .NET's own assemblies under the alias `bcl` as well: the payload's
       TlsBridge.cs reaches the .NET types lib/'s take the place of (Stream,
       SslStream) through it, to run .NET's TLS over lib/'s sockets. -->
  <Target Name="ZeroBclAlias" AfterTargets="ResolveAssemblyReferences" BeforeTargets="FindReferenceAssembliesForReferences"
          Condition="'$(ZeroDotnetTypes)' != 'Net' and '$(ZeroLanguage)' == 'CSharp'">
    <ItemGroup>
      <_ZeroBclReference Include="@(ReferencePath)" Condition="'%(ReferencePath.FrameworkReferenceName)' == 'Microsoft.NETCore.App'" />
      <ReferencePath Remove="@(_ZeroBclReference)" />
      <ReferencePath Include="@(_ZeroBclReference)" Aliases="global,bcl" />
    </ItemGroup>
  </Target>

  <Target Name="ZeroCheckDotnetTarget" BeforeTargets="Restore;_CheckForInvalidConfigurationAndPlatform;CoreCompile">
    <Error Code="ZERO016" Condition="'$(NETCoreSdkVersion)' != '' and $([MSBuild]::VersionLessThan($([System.Text.RegularExpressions.Regex]::Replace('$(NETCoreSdkVersion)', '-.*', '')), '11.0.100'))"
           Text="ZeroTarget=dotnet needs the .NET SDK 11.0.100 or newer (the program targets $(ZeroDotnetFramework)); this build uses $(NETCoreSdkVersion)." />
    <Error Code="ZERO016" Condition="'$(ZeroDotnetTypes)' != 'Zero' and '$(ZeroDotnetTypes)' != 'Net'"
           Text="ZeroDotnetTypes is '$(ZeroDotnetTypes)': use Zero (lib/'s own Task, streams and sockets, the default) or Net (.NET's own)." />
    <Error Code="ZERO016" Condition="'$(ZeroLanguage)' == 'FSharp' and '$(ZeroDotnetTypes)' == 'Net'"
           Text="ZeroDotnetTypes=Net is for C# projects: F# projects on ZeroTarget=dotnet use lib/'s own Task, streams and sockets (ZeroCSharp.Dotnet)." />
    <Error Code="ZERO016" Condition="'$(ZeroLanguage)' == 'CSharp' and '$(OutputType)' == 'Library'"
           Text="ZeroTarget=dotnet builds C# programs, not C# libraries: lib/ is compiled into a C# program, and a library of its own would get a second copy of its types. (F# libraries work: F# projects share one lib/ assembly.)" />
    <Error Code="ZERO016" Condition="'$(ZeroLanguage)' == 'CSharp' and '@(ProjectReference)' != ''"
           Text="ZeroTarget=dotnet doesn't build C# projects that reference zero libraries (@(ProjectReference->'%(Filename)', ', ')): lib/ is compiled into a C# program, and a library's lib/ types would be others. (F# projects can.)" />
    <Error Code="ZERO016" Condition="'$(ZeroLanguage)' == 'FSharp' and '$(NuGetPackageRoot)' != '' and !Exists('$(ZeroDotnetLibDir)ZeroLib.dll')"
           Text="ZeroCSharp.Dotnet $(ZeroSdkVersion), which F# projects on ZeroTarget=dotnet reference, isn't in $(NuGetPackageRoot): restore the project (it's on nuget.org with each release of ZeroCSharp.Sdk)." />
    <Error Code="ZERO016" Condition="$([MSBuild]::IsOSPlatform('Windows'))"
           Text="ZeroTarget=dotnet builds on macOS and Linux for now: on Windows, lib/'s calls to the C library need the functions win/runtime.c gives a zero-mode program, as a library for .NET to load." />
    <Error Code="ZERO016" Condition="$([MSBuild]::IsOSPlatform('OSX')) and !Exists('$(ZeroDotnetDir)native/osx/libzerocompat.dylib')"
           Text="This build of ZeroCSharp.Sdk has no libzerocompat.dylib (payload/dotnet/native/osx), which ZeroTarget=dotnet needs on macOS: it was packed on a machine that couldn't build it." />
  </Target>
</Project>
