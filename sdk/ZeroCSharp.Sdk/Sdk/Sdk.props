<!--
  ZeroCSharp.Sdk: zero-mode C# and F# projects (.csproj, .fsproj).
  <Project Sdk="ZeroCSharp.Sdk/0.15.0">.

  A project gets a target framework of its own, ZeroFramework (zero03, in
  version.props), and compiles against zerocore (the core library,
  System.Private.CoreLib) and lib/ (BflatLib) instead of .NET's libraries.
  NuGet then refuses ordinary .NET packages, and packages of zero libraries
  built for another framework, with NU1202.
-->
<Project>
  <Import Project="$(MSBuildThisFileDirectory)version.props" />
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <ZeroSdkRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</ZeroSdkRoot>
  </PropertyGroup>

  <!-- ZeroTarget=dotnet: the same project as an ordinary .NET program, on
       .NET's own runtime (for its debugger, profilers and test tools, or to
       check a program against .NET itself). Not a zero-mode build at all:
       .NET's framework and core library, with lib/ compiled into the
       program as source, so that its Task, timers, streams, sockets and
       Console take the place of .NET's and the program behaves as in zero
       mode (Sdk.targets). It has to be known here, before the project's own
       properties: pass it on the command line (-p:ZeroTarget=dotnet) or set
       it in Directory.Build.props. -->
  <PropertyGroup Condition="'$(ZeroTarget)' == 'dotnet'">
    <_ZeroDotnet>true</_ZeroDotnet>
    <ZeroDotnetFramework Condition="'$(ZeroDotnetFramework)' == ''">net11.0</ZeroDotnetFramework>
    <TargetFramework>$(ZeroDotnetFramework)</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <Features>$(Features);updated-memory-safety-rules</Features>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ZeroLanguage Condition="'$(MSBuildProjectExtension)' == '.fsproj'">FSharp</ZeroLanguage>
    <ZeroLanguage Condition="'$(ZeroLanguage)' == ''">CSharp</ZeroLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_ZeroDotnet)' != 'true'">
    <ZeroSdkTfm>$(ZeroFramework)</ZeroSdkTfm>

    <!-- NuGet reads a framework name it doesn't know as name + version 0.0,
         so the version is part of the name. -->
    <TargetFramework>$(ZeroSdkTfm)</TargetFramework>
    <!-- A Directory.Build.props of the repository around the project may set
         these for its .NET projects; a zero project has one framework and
         none of .NET's global usings. -->
    <TargetFrameworks></TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <TargetFrameworkIdentifier>$(ZeroSdkTfm)</TargetFrameworkIdentifier>
    <TargetFrameworkVersion>v0.0</TargetFrameworkVersion>
    <TargetFrameworkMoniker>$(ZeroSdkTfm),Version=v0.0</TargetFrameworkMoniker>

    <!-- No .NET: zerocore and lib/ are the whole framework. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <NoCompilerStandardLib>true</NoCompilerStandardLib>
    <!-- zerocore has no assembly-info or target-framework attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateDependencyFile>false</GenerateDependencyFile>

    <!-- C# or F#, by the project file's extension. -->
    <ZeroLanguage Condition="'$(MSBuildProjectExtension)' == '.fsproj'">FSharp</ZeroLanguage>
    <ZeroLanguage Condition="'$(ZeroLanguage)' == ''">CSharp</ZeroLanguage>

    <!-- The language as build.sh compiles it. -->
    <LangVersion Condition="'$(ZeroLanguage)' == 'CSharp'">preview</LangVersion>
    <Features Condition="'$(ZeroLanguage)' == 'CSharp'">$(Features);updated-memory-safety-rules</Features>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The [LibraryImport] generator's file, for bflat, which runs no generators. -->
    <EmitCompilerGeneratedFiles Condition="'$(ZeroLanguage)' == 'CSharp'">true</EmitCompilerGeneratedFiles>

    <!-- F#: the payload's FSharp.Core (ref/fsharp/, see fsharp/build-core.sh),
         not the NuGet one, which needs .NET. No reflection, so records and
         unions get no sprintf-based ToString. zerocore's metadata version is
         empty, and fsc would copy it into old-format metadata tables that
         bflat misreads; the metadataversion option sets it, and is "for test
         purposes" (FS0075). -->
    <DisableImplicitFSharpCoreReference Condition="'$(ZeroLanguage)' == 'FSharp'">true</DisableImplicitFSharpCoreReference>
    <ReflectionFree Condition="'$(ZeroLanguage)' == 'FSharp'">true</ReflectionFree>
    <OtherFlags Condition="'$(ZeroLanguage)' == 'FSharp'">$(OtherFlags) --metadataversion:v4.0.30319</OtherFlags>
    <NoWarn Condition="'$(ZeroLanguage)' == 'FSharp'">$(NoWarn);FS0075</NoWarn>
    <!-- fsc calls [<UnmanagedCallersOnly>] unsupported (FS0202); a native
         library's exports are made from it (Sdk.targets, ZeroFSharpEntry). -->
    <NoWarn Condition="'$(ZeroLanguage)' == 'FSharp'">$(NoWarn);FS0202</NoWarn>
    <!-- A library's IL is what programs compile from: optimize it, as build.sh's -O does. -->
    <Optimize>true</Optimize>

    <!-- The compiler's output is IL, always a .dll: the native program built
         from the same sources takes the plain name (or .exe for Windows). -->
    <TargetExt>.dll</TargetExt>
    <UseAppHost>false</UseAppHost>

    <!-- The native step (Sdk.targets). The host is the machine running the
         build: Linux x64 and arm64, and Windows x64. -->
    <ZeroHostRid Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">linux-x64</ZeroHostRid>
    <ZeroHostRid Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">linux-arm64</ZeroHostRid>
    <ZeroHostRid Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">win-x64</ZeroHostRid>
    <ZeroHostRid Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">osx-arm64</ZeroHostRid>
    <!-- linux-x64, linux-arm64, win-x64, osx-arm64, iossimulator-arm64 (the
         iOS simulator on an Apple Silicon Mac: a console program, no app
         bundle; ZeroIosMinimum, default 17.0, is the oldest iOS it starts on,
         and dotnet run runs it in ZeroIosSimulator, a simulator's name or
         UDID, or the booted one, or the first iPhone), uefi-x64 and uefi-arm64
         (a program the firmware starts, no operating system), c64 (the
         Commodore 64), or pico2 and r4 (the Raspberry Pi Pico 2 and the
         Arduino Uno R4 microcontrollers); the host's own by default. A chosen
         one (here: on the command line or in Directory.Build.props) gets an
         output folder of its own, see Sdk.targets. -->
    <ZeroTargetChosen Condition="'$(ZeroTarget)' != ''">true</ZeroTargetChosen>
    <ZeroTarget Condition="'$(ZeroTarget)' == ''">$(ZeroHostRid)</ZeroTarget>
    <!-- None (-O0), Speed (bflat's default) or Size (-Os). Debug builds aren't
         optimized, so a debugger stops on every line and sees every local;
         other configurations are. (The IL above is optimized either way.) -->
    <ZeroOptimizeFor Condition="'$(ZeroOptimizeFor)' == '' and '$(Configuration)' == 'Debug'">None</ZeroOptimizeFor>
    <ZeroOptimizeFor Condition="'$(ZeroOptimizeFor)' == ''">Speed</ZeroOptimizeFor>
    <!-- Programs and libraries leave out debug information and the symbol
         table, except in Debug builds, where the debugger needs them: about
         half of a Linux or macOS program. (On Windows the debug information
         is a .pdb file beside the program; it isn't written.) -->
    <ZeroStripSymbols Condition="'$(ZeroStripSymbols)' == '' and '$(Configuration)' == 'Debug'">false</ZeroStripSymbols>
    <ZeroStripSymbols Condition="'$(ZeroStripSymbols)' == ''">true</ZeroStripSymbols>
    <!-- false: leave out Chinese's, Japanese's and Korean's own orders of
         ideographs (pinyin, strokes, Japan's, hanja with their reading),
         about 300 KB of a program that compares with those cultures; they
         then sort ideographs by radical and strokes, as other cultures do. -->
    <ZeroIdeographOrders Condition="'$(ZeroIdeographOrders)' == ''">true</ZeroIdeographOrders>
    <!-- dotnet publish builds Release, as it does for .NET 8 and later (which
         decide by the target framework, and don't know this one). -->
    <PublishRelease Condition="'$(PublishRelease)' == ''">true</PublishRelease>
    <!-- ZeroDllImports: more libraries whose [DllImport]s are bound when the
         program is linked, besides libc and libm.so.6, which always are. -->
    <!-- ZeroLinkLibrary (item): a C library the program links with, by name
         (SDL3: libSDL3.so, libSDL3.tbd or .dylib, SDL3.lib, and its
         [DllImport("SDL3")]s bound) or by path. Referencing projects and
         packages pass it on. ZeroLibraryPath: folders searched for names
         first; building for the machine's own system, its usual library
         folders follow (Homebrew's on macOS). -->
    <!-- ZeroInstructionSet: passed to bflat as -m (x86-64-v3, dotprod, ...). -->
    <!-- ZeroGpu: Metal compiles the program's [RuntimeExport("Name")] methods
         for the GPU as well, as kernels lib/Gpu.cs launches (Gpu.Run("Name", ...)).
         For ZeroTarget osx-arm64, on an Apple Silicon Mac with Xcode, its Metal
         Toolchain (xcodebuild -downloadComponent MetalToolchain) and Docker,
         which runs NativeAOT-LLVM, the compiler of the kernels' first step.
         Cuda (experimental: not yet run on an NVIDIA GPU) does the same for
         NVIDIA GPUs: ZeroTarget linux-x64 or linux-arm64, built on any host
         with a clang that has the NVPTX backend (Linux's clang, LLVM's own,
         Homebrew's llvm; not Apple's), found or set as ZeroCudaClang. The
         kernels are PTX for ZeroCudaArch (default sm_70), checked by ptxas
         when it's on the PATH; the program opens the CUDA driver when it
         runs, so building needs no CUDA toolkit. -->

    <!-- dotnet pack: the dll goes to lib/<framework>/ by a target in Sdk.targets,
         because NuGet's pack rejects build output for a framework it doesn't know. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5103;NU5128</NoWarn>
  </PropertyGroup>

  <!-- (ZeroTarget=dotnet: .NET's own [LibraryImport] generator does it.) -->
  <ItemGroup Condition="'$(ZeroLanguage)' == 'CSharp' and '$(_ZeroDotnet)' != 'true'">
    <Analyzer Include="$(ZeroSdkRoot)payload/analyzers/ZeroCSharp.LibraryImport.dll" />
  </ItemGroup>
</Project>
