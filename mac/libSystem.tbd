--- !tapi-tbd
# Our own stand-in for macOS's libSystem, which the SDK links osx-arm64
# programs against (ld64.lld), so no Apple SDK is needed; and iOS's, which
# has the same names, for iossimulator-arm64 programs. It lists names
# only: at run time the programs bind to the real /usr/lib/libSystem.B.dylib,
# which has all of them (libc, libm and pthreads are one library on macOS).
#
# What's here: every C function zerocore/ and lib/ import ([DllImport]s with
# "*", "libc" and "libm.so.6"), what mac/*.c call (and __tlv_bootstrap, for
# runtime.c's __thread variable), and C functions
# programs commonly import (stdio, stdlib, string, time, unistd, dlfcn, math).
# A program that imports one that isn't listed fails to link with
# "undefined symbol: _name". In this repository, add it below, with its
# leading underscore, in sorted order; in a project, list it in a .tbd of the
# project's own with this install name, in ZeroNativeInput
# (docs/get-started/install-with-dotnet.md).
tbd-version:     4
targets:         [ arm64-macos, arm64-ios-simulator ]
install-name:    '/usr/lib/libSystem.B.dylib'
current-version: 1351
exports:
  - targets:     [ arm64-macos, arm64-ios-simulator ]
    symbols:     [ ___error, ___stack_chk_fail, ___stack_chk_guard, ___stderrp,
                   ___stdinp, ___stdoutp, __tlv_bootstrap, _abort, _abs, _accept, _access, _acos,
                   _acosf, _aligned_alloc, _arc4random, _arc4random_buf,
                   _arc4random_uniform, _asin, _asinf, _atan, _atan2, _atan2f,
                   _atanf, _atexit, _atof, _atoi, _atol, _atoll, _bind,
                   _bsearch, _bzero, _calloc, _cbrt, _cbrtf, _ceil, _ceilf,
                   _cfmakeraw, _chdir, _clock, _clock_gettime,
                   _clock_gettime_nsec_np, _close, _closedir, _connect, _cos,
                   _cosf, _cosh, _coshf, _difftime, _div, _dlclose, _dlerror, _dlopen,
                   _dlsym, _dup, _dup2, _dyld_stub_binder, _execve, _execvp,
                   _exit, _exp, _exp2, _exp2f, _expf, _expm1, _fabs, _fabsf,
                   _fclose, _fcntl, _feof, _ferror, _fflush, _fgetc, _fgets,
                   _floor, _floorf, _fma, _fmaf, _fmax, _fmaxf, _fmin, _fminf,
                   _fmod, _fmodf, _fopen, _fork, _fprintf, _fputc, _fputs,
                   _fread, _free, _freeaddrinfo, _frexp, _fscanf, _fseek,
                   _fseeko, _fstat, _fsync, _ftell, _ftello, _fwrite,
                   _getaddrinfo, _getchar, _getcwd, _getentropy, _getenv,
                   _gethostname, _getpagesize, _getpeername, _getpid, _getppid, _getsockname,
                   _getsockopt, _gettimeofday, _gmtime, _gmtime_r, _hypot,
                   _hypotf, _isatty, _kill, _labs, _ldexp, _ldexpf, _ldiv, _listen,
                   _llabs, _localtime, _localtime_r, _log, _log10, _log10f,
                   _log1p, _log2, _log2f, _logf, _lseek, _lstat, _malloc,
                   _memchr, _memcmp, _memcpy, _memmove, _memset, _mkdir,
                   _mktime, _mmap, _modf, _mprotect, _munmap, _nanosleep, _open,
                   _opendir, _perror, _pipe, _poll, _posix_memalign, _pow,
                   _powf, _printf, _pthread_create, _pthread_detach,
                   _pthread_getspecific, _pthread_join, _pthread_key_create,
                   _pthread_key_delete, _pthread_mutex_destroy,
                   _pthread_mutex_init, _pthread_mutex_lock,
                   _pthread_mutex_unlock, _pthread_self, _pthread_setspecific,
                   _putchar, _puts, _qsort, _raise, _rand, _read, _readdir,
                   _realloc, _recvfrom, _remove, _rename, _rewind, _rint,
                   _rintf, _rmdir, _round, _roundf, _scanf, _sched_yield,
                   _sendto, _setenv, _setsockopt, _setvbuf, _shutdown, _sigaction, _signal,
                   _sin, _sinf, _sinh, _sinhf, _sleep, _snprintf, _socket,
                   _sprintf, _sqrt, _sqrtf, _srand, _sscanf, _stat, _strcat,
                   _strchr, _strcmp, _strcpy, _strcspn, _strdup, _strerror,
                   _strftime, _strlen, _strncat, _strncmp, _strncpy, _strndup,
                   _strnlen, _strrchr, _strspn, _strstr, _strtod, _strtof,
                   _strtok_r, _strtol, _strtoll, _strtoul, _strtoull, _sysconf,
                   _system, _tan, _tanf, _tanh, _tanhf, _tcgetattr, _tcsetattr,
                   _time, _trunc, _truncf, _unlink, _unsetenv, _usleep,
                   _vfprintf, _vprintf, _vsnprintf, _vsprintf, _waitpid, _write ]
...
