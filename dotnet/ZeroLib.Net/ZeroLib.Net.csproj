<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../NetTypes.props" />
  <!-- lib/ as one .NET assembly with .NET's own Task, streams and sockets
       (dotnet/ZeroCompat's sources, and the startup dotnet/Sample's programs
       get), for F# projects on ZeroTarget=dotnet with ZeroDotnetTypes=Net:
       they then use FSharp.Core's task { } and async { } over .NET's tasks,
       and can hand them to and take them from any .NET library. Nothing here
       has a .NET type's name (CS0436 is an error), so nothing shadows .NET.
       sdk/pack.sh packs it inside ZeroCSharp.Dotnet.Net. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>ZeroLib.Net</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);ZERO_DOTNET;ZERO_DOTNET_BCL</DefineConstants>
    <WarningsAsErrors>$(WarningsAsErrors);CS0436</WarningsAsErrors>
    <!-- lib/'s own warnings, as the SDK payload's zero.editorconfig silences them. -->
    <NoWarn>$(NoWarn);CS8500;CS8632;CS8669;CS0618;CS8909;CS0414;CS0169;CS0649</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../lib/*.cs" />
    <Compile Remove="@(ZeroLibOwnTypes->'../../lib/%(Identity).cs')" />
    <Compile Remove="../../lib/Crypto*.cs;../../lib/SslStream.cs;../../lib/Tls*.cs" />
    <Compile Include="../../lib/CryptoX25519.cs" />
    <Compile Include="../ZeroCompat/*.cs" />
    <Compile Include="../Sample/ZeroStartup.cs" />
    <PackageReference Include="System.Numerics.Tensors" Version="11.0.0" />
  </ItemGroup>
</Project>
