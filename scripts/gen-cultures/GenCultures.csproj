<Project Sdk="Microsoft.NET.Sdk">
  <!-- Run with "dotnet run" in this folder, or dotnet run - -project scripts/gen-cultures.
       Rewrites zerocore/System/Globalization/CultureData.cs from this .NET's
       culture data (ICU, so InvariantGlobalization is off). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
